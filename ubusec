render_text() { # render_text MAX_DETAILS
  local max=$1 sev mod msg det rank cnt line k
  local -A cnt_by=([KRITISCH]=0 [HOCH]=0 [MITTEL]=0 [NIEDRIG]=0 [INFO]=0)
  while IFS=$'\t' read -r rank sev _; do cnt_by[$sev]=$((cnt_by[$sev]+1)); done <"$SORTED"
  local hr="════════════════════════════════════════════════════════════════════════"
  echo "$hr"
  c bold " ubusec $UBUSEC_VERSION · $(hostname -f 2>/dev/null || hostname) · Ubuntu $OS_VERSION · $MODE_LABEL"; echo
  echo " $(date -d "@$T0" '+%d.%m.%Y %H:%M') · Dauer $(fmt_dur $(( $(date +%s) - T0 )))"
  echo "$hr"
  printf ' '
  for k in KRITISCH HOCH MITTEL NIEDRIG INFO; do
    if (( cnt_by[$k] > 0 )); then c "$k" "$k ${cnt_by[$k]}"; else c dim "$k 0"; fi
    [ "$k" != INFO ] && printf '  │  '
  done
  echo; echo
  if (( $(grep -c . "$SORTED") == 0 )); then c ok " ✔ Keine Auffälligkeiten."; echo; fi
  local lastmod=""
  while IFS=$'\t' read -r rank sev mod msg det; do
    if [ "$mod" != "$lastmod" ]; then
      echo; c bold "▌ ${MOD_TITLE[$mod]:-$mod}"; echo; lastmod=$mod
    fi
    printf '  '; c "$sev" "$(printf '%-8s' "$sev")"; printf '  %s' "$msg"
    is_new "$sev" "$mod" "$msg" && { printf '  '; c MITTEL "[NEU]"; }
    echo
    if [ -n "$det" ]; then
      local n=0 d arr=()
      IFS=$'\x1f' read -r -a arr <<<"$det"
      for d in "${arr[@]}"; do
        n=$((n+1))
        if [ "$max" -gt 0 ] && (( n > max )); then
          c dim "            … (vollständig im Bericht)"; echo; break
        fi
        c dim "            ↳ $d"; echo
      done
    fi
  done < <(ordered)
  echo
  echo "$hr"
  printf ' Module: '
  for k in $RUN_MODULES; do printf '%s %s  ' "$k" "$(fmt_dur "${MOD_TIME[$k]:-0}")"; done; echo
  (( SUPPRESSED > 0 )) && echo " $SUPPRESSED Meldung(en) per $IGNORE_FILE ausgeblendet"
  echo " Bericht: $REPORT_TXT"
  echo " HTML:    $REPORT_HTML"
  echo " Rohdaten der Tools: $RAW/"
}

