</style></head><body><main>
<h1>Sicherheitsbericht $(hostname -f 2>/dev/null | html_esc)</h1>
<div class="meta">Ubuntu $OS_VERSION · $MODE_LABEL · $(date -d "@$T0" '+%d.%m.%Y %H:%M') · ubusec $UBUSEC_VERSION</div><div class="sum">
EOF
  local k
  for k in KRITISCH HOCH MITTEL NIEDRIG INFO; do
    echo "<span class=\"b $k\">$k $(awk -F'\t' -v s=$k '$2==s' "$SORTED" | grep -c .)</span>"
  done
  echo "</div>"
  local lastmod=""
  while IFS=$'\t' read -r rank sev mod msg det; do
    [ "$mod" != "$lastmod" ] && { echo "<h2>${MOD_TITLE[$mod]:-$mod}</h2>"; lastmod=$mod; }
    printf '<div class="f"><span class="b %s">%s</span><div>%s' "$sev" "$sev" "$(html_esc <<<"$msg")"
    is_new "$sev" "$mod" "$msg" && printf '<span class="new">NEU</span>'
    if [ -n "$det" ]; then
      local arr=(); IFS=$'\x1f' read -r -a arr <<<"$det"
      echo "<ul>"; for d in "${arr[@]}"; do echo "<li>$(html_esc <<<"$d")</li>"; done; echo "</ul>"
    fi
    echo "</div></div>"
  done < <(ordered)
  echo "</main></body></html>"
}

ordered() { # Meldungen nach Modulreihenfolge, darin nach Schwere
  awk -F'\t' -v order="$ALL_MODULES" 'BEGIN{n=split(order,o," ");for(i=1;i<=n;i++)idx[o[i]]=i}{print idx[$3]"\t"$0}' "$SORTED" \
    | sort -t$'\t' -k1,1n -k2,2nr -s | cut -f2-
}

write_json() {
  local rank sev mod msg det
  : >"$RAW/findings.flag.tsv"
  while IFS=$'\t' read -r rank sev mod msg det; do
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$rank" "$sev" "$mod" "$msg" "$det" "$(is_new "$sev" "$mod" "$msg" && echo 1 || echo 0)"
  done < <(ordered) >"$RAW/findings.flag.tsv"
  local mt="" m
  for m in $RUN_MODULES; do mt+="$m=${MOD_TIME[$m]:-0},"; done
  J_HOST=$(hostname -f 2>/dev/null || hostname) J_OS="$OS_VERSION" J_CODENAME="$OS_CODENAME" J_MODE="$MODE" \
  J_LABEL="$MODE_LABEL" J_START="$T0" J_END="$(date +%s)" J_TRIGGER="$TRIGGER" J_MODTIMES="$mt" \
  J_RAW="$RAW" J_TXT="$REPORT_TXT" J_HTML="$REPORT_HTML" J_VERSION="$UBUSEC_VERSION" J_SUPP="$SUPPRESSED" \
  J_LYNIS="$(awk -F= '/^hardening_index=/{print $2; exit}' "$RAW/lynis-report.dat" 2>/dev/null)" \
  J_ID="$TS-$MODE" python3 - "$RAW/findings.flag.tsv" "$REPORT_JSON" <<'PY2'
import sys, os, json
W = {"KRITISCH": 25, "HOCH": 10, "MITTEL": 4, "NIEDRIG": 1, "INFO": 0}
fs, counts = [], {k: 0 for k in W}
for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
    p = line.rstrip("\n").split("\t")
    if len(p) < 6: continue
    rank, sev, mod, msg, det, new = p[:6]
    counts[sev] = counts.get(sev, 0) + 1
    fs.append({"severity": sev, "rank": int(rank), "module": mod, "message": msg,
               "details": [d for d in det.split("\x1f") if d], "new": new == "1"})
e = os.environ
mt = {}
for kv in e["J_MODTIMES"].split(","):
    if "=" in kv: k, v = kv.split("="); mt[k] = int(v)
doc = {"id": e["J_ID"], "version": e["J_VERSION"], "host": e["J_HOST"], "os": e["J_OS"],
       "codename": e["J_CODENAME"], "mode": e["J_MODE"], "label": e["J_LABEL"],
       "started": int(e["J_START"]), "finished": int(e["J_END"]), "trigger": e["J_TRIGGER"],
       "modules": mt, "counts": counts, "suppressed": int(e["J_SUPP"] or 0),
       "score": max(0, 100 - sum(W[k] * v for k, v in counts.items() if k in W)),
       "lynis_index": int(e["J_LYNIS"]) if e["J_LYNIS"].isdigit() else None,
       "raw_dir": e["J_RAW"], "report_txt": e["J_TXT"], "report_html": e["J_HTML"], "findings": fs}
tmp = sys.argv[2] + ".tmp"
with open(tmp, "w", encoding="utf-8") as f: json.dump(doc, f, ensure_ascii=False, indent=1)
os.replace(tmp, sys.argv[2])
PY2
}

fmt_dur() { local s=$1; if (( s >= 60 )); then printf '%dm%02ds' $((s/60)) $((s%60)); else printf '%ds' "$s"; fi; }

declare -A PREV_KEYS=()
load_prev() {
  local f=$STATE_DIR/last-findings.$MODE.tsv sev mod msg
  [ -r "$f" ] || return 0
  while IFS=$'\t' read -r _ sev mod msg _; do PREV_KEYS["$sev|$mod|$msg"]=1; done <"$f"
  HAVE_PREV=1
}
HAVE_PREV=0
is_new() { [ "$HAVE_PREV" = 1 ] && [ "$1" != INFO ] && [ -z "${PREV_KEYS["$1|$2|$3"]:-}" ]; }

notify() {
  [ "$NOTIFY" = 1 ] || return 0
  [ -n "$MAIL_TO$NTFY_URL" ] || return 0
  local min=${RANK[$NOTIFY_MIN]:-3} relevant=0 rank sev mod msg
  while IFS=$'\t' read -r rank sev mod msg _; do
    (( rank >= min )) || continue
    if [ "$NOTIFY_ONLY_NEW" = 1 ] && [ "$HAVE_PREV" = 1 ]; then is_new "$sev" "$mod" "$msg" || continue; fi
    relevant=$((relevant+1))
  done <"$SORTED"
  (( relevant > 0 )) || return 0
  send_message "[ubusec] $(hostname): $SUMMARY" "$REPORT_TXT" "$SUMMARY – Bericht: $REPORT_TXT" || log "Hinweis: $NOTIFY_RESULT"
  return 0
}

# send_message BETREFF TEXTDATEI KURZTEXT  → 0, wenn mindestens ein Kanal funktionierte
NOTIFY_RESULT=""
send_message() {
  local subj=$1 body=$2 short=$3 ok=1 r=""
  if [ -n "$MAIL_TO" ]; then
    if have mail; then
      # shellcheck disable=SC2086
      if mail -s "$subj" ${MAIL_TO//,/ } <"$body"; then ok=0; r+="E-Mail an $MAIL_TO übergeben. "; else r+="E-Mail-Versand fehlgeschlagen. "; fi
    elif have sendmail; then
      if { echo "Subject: $subj"; echo "To: $MAIL_TO"; echo "Content-Type: text/plain; charset=UTF-8"; echo; cat "$body"; } | sendmail -t; then
        ok=0; r+="E-Mail an $MAIL_TO übergeben. "; else r+="E-Mail-Versand fehlgeschlagen. "; fi
    else r+="Kein Mailprogramm installiert (apt install bsd-mailx). "; fi
  fi
  if [ -n "$NTFY_URL" ]; then
    if curl -fsS -m 20 -H "Title: ubusec $(hostname)" -H "Priority: high" -d "$short" "$NTFY_URL" >/dev/null 2>&1; then
      ok=0; r+="ntfy-Nachricht gesendet. "; else r+="ntfy-Versand fehlgeschlagen. "; fi
  fi
  [ -z "$MAIL_TO$NTFY_URL" ] && r="Kein Empfänger eingestellt."
  NOTIFY_RESULT=$r
  return $ok
}

# ============================================================================
#  Installation / Baseline
