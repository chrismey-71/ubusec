# Ordner, die der Virenscan auslässt (eine Zeile pro Pfad)
nextcloud_datadirs() {
  local dir=$CHECK_DIR; [ -f "$dir/webcheck.py" ] || dir=$SRC_DIR/checks
  [ -f "$dir/webcheck.py" ] && WEB_PATHS="$WEB_PATHS" timeout 120 python3 -I "$dir/webcheck.py" nc-datadirs 2>/dev/null
}
backup_dirs() { local p; for p in /backup /backups /var/backups /root/backup /root/backups /home/*/backup /home/*/backups; do [ -d "$p" ] && echo "$p"; done; }
clam_excludes() {
  local p
  printf '%s\n' /proc /sys /dev /run /snap /var/lib/docker /var/lib/containerd /var/lib/lxcfs /var/lib/clamav \
    "$LOG_DIR" "$STATE_DIR" /swapfile /swap.img
  # Signaturen und Quarantäne anderer Virenscanner enthalten absichtlich Schadcode-Muster – sonst meldet ClamAV
  # z. B. /usr/local/maldetect/sigs/rfxn.yara als „Html.Downloader…“ (Fehlalarm, kein Befall)
  printf '%s\n' /usr/local/maldetect/sigs /usr/local/maldetect/quarantine /usr/local/maldetect/tmp \
    /usr/local/maldetect/clean /var/lib/rkhunter/db /var/lib/chkrootkit
  [ "$CLAM_EXCLUDE_DB" = 1 ] && printf '%s\n' /var/lib/mysql /var/lib/postgresql /var/lib/mongodb /var/lib/redis
  [ "$CLAM_EXCLUDE_BACKUPS" = 1 ] && backup_dirs
  if [ "$CLAM_EXCLUDE_LOGS" = 1 ]; then echo /var/log; for p in /home/*/logs /home/*/domains/*/logs; do [ -d "$p" ] && echo "$p"; done; fi
  if [ "$CLAM_EXCLUDE_MAIL" = 1 ]; then echo /var/mail; for p in /home/*/Maildir /home/*/homes/*/Maildir; do [ -d "$p" ] && echo "$p"; done; fi
  [ "$CLAM_EXCLUDE_NEXTCLOUD" = 1 ] && nextcloud_datadirs
  for p in $CLAM_EXCLUDE_CUSTOM; do echo "${p%/}"; done
  return 0
}

# Speichergrenze der Scan-Dienste in MB: 40 % des Arbeitsspeichers, aber mindestens 2,5 GB
# (damit ein clamscan-Prozess sicher hineinpasst) und höchstens 75 %
scan_mem_limit_mb() {
  local tot lim
  tot=$(awk '/^MemTotal:/{print int($2/1024)}' /proc/meminfo); tot=${tot:-4096}
  lim=$(( tot * 40 / 100 )); (( lim < 2560 )) && lim=2560
  (( lim > tot * 75 / 100 )) && lim=$(( tot * 75 / 100 ))
  echo "$lim"
}
CLAM_PROC_MB=1400   # Bedarf eines clamscan-Prozesses (fast nur die Virensignaturen), mit Reserve
# Wie viele clamscan-Prozesse in die Speichergrenze passen
clam_fit() { local n=$(( ($(scan_mem_limit_mb) - 512) / CLAM_PROC_MB )); (( n < 1 )) && n=1; echo "$n"; }

# Automatische Anzahl eigener clamscan-Prozesse: so viele, wie in die Speichergrenze passen
# und gerade frei ist (2 GB Reserve für Webserver und Datenbank), höchstens Kerne − 1
clam_auto_workers() {
  local cpus avail budget cap n
  cpus=$(nproc 2>/dev/null || echo 1)
  avail=$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo)
  budget=$(( ${avail:-2048} - 2048 )); cap=$(( $(scan_mem_limit_mb) - 512 ))
  (( budget > cap )) && budget=$cap
  n=$(( budget / CLAM_PROC_MB ))
  (( n > cpus - 1 )) && n=$(( cpus - 1 ))
  (( n > 6 )) && n=6
  (( n < 1 )) && n=1
  echo "$n"
}

# ClamAV-Dienst (clamd): Läuft er ohnehin (Virtualmin-Mailfilter, Nextcloud „Antivirus for files“),
# prüft ubusec über ihn – die Signaturen liegen dann nur einmal im Speicher.
clamd_conf() { local k=$1 f=/etc/clamav/clamd.conf; [ -r "$f" ] && awk -v k="$k" '$1==k{print $2; exit}' "$f"; }
clamd_running() { systemctl is-active -q clamav-daemon 2>/dev/null || pgrep -x clamd >/dev/null 2>&1; }
clamd_usable() { # prüft wirklich eine Datei über den Dienst (Verbindung und Dateiübergabe)
  have clamdscan && clamd_running || return 1
  local out
  out=$(timeout 60 clamdscan --fdpass --no-summary /etc/os-release 2>&1) || return 1
  [[ $out == *": OK"* ]]
}
clam_engine() { if [ "${CLAM_ENGINE:-auto}" = auto ] && clamd_usable; then echo clamd; else echo clamscan; fi; }
# Parallele Prüfungen über den Dienst: halb so viele wie Kerne (höchstens 4), damit der Dienst
# genug Threads für eingehende Mails und Nextcloud-Uploads behält
clamd_auto_workers() {
  local cpus n mt
  cpus=$(nproc 2>/dev/null || echo 1); n=$(( cpus / 2 ))
  mt=$(clamd_conf MaxThreads); mt=${mt:-10}
  (( n > mt - 2 )) && n=$(( mt - 2 ))
  (( n > 4 )) && n=4
  (( n < 1 )) && n=1
  echo "$n"
}
clam_workers() { # clam_workers ENGINE
  if [ "${CLAM_PARALLEL:-0}" -gt 0 ] 2>/dev/null; then echo "$CLAM_PARALLEL"
  elif [ "$1" = clamd ]; then clamd_auto_workers; else clam_auto_workers; fi
}

CLAM_GONE_RX='No such file|lstat\(\) failed|File path check failure'
# Erledigte Dateien: Ausgabezeilen der Scanner bzw. fertige Teillisten beim ClamAV-Dienst
clam_count() {
  local a b
  a=$(cat "$RAW"/clam.out.* 2>/dev/null | wc -l)
  b=$(cat "$RAW"/clam.done.* 2>/dev/null | awk '{s+=$1} END{print s+0}')
  (( b > a )) && a=$b
  (( SUB_TOTAL > 0 && a > SUB_TOTAL )) && a=$SUB_TOTAL
  echo "$a"
}

# Fortschritt für die Weboberfläche: erledigte Dateien zählen, aktuellen Ordner zeigen
clam_progress() {
  local out
  while sleep 8; do
    SUB_DONE=$(clam_count)
    out=$(ls -t "$RAW"/clam.out.* 2>/dev/null | head -1)
    SUB_TEXT=$(tail -n1 "$out" 2>/dev/null | sed -E 's/: [^:]*$//'); SUB_TEXT=${SUB_TEXT%/*}
    write_status true malware "$MOD_I" "$MOD_N"
  done
}

# Ein Prüfstrang über den ClamAV-Dienst: arbeitet seine Teillisten nacheinander ab.
# Rückgabe 3, wenn der Dienst nicht mehr antwortet (der Rest wird dann mit clamscan nachgeholt).
clamd_worker() { # clamd_worker ID TEILLISTE…
  local id=$1 p r cp=""; shift
  trap '[ -n "$cp" ] && kill "$cp" 2>/dev/null; exit 143' TERM
  for p in "$@"; do
    nice -n 19 ionice -c3 clamdscan --fdpass --no-summary -f "$p" >>"$RAW/clam.out.$id" 2>>"$RAW/clam.err.$id" &
    cp=$!; r=0; wait "$cp" || r=$?; cp=""
    if (( r >= 2 )) && ! clamd_usable; then return 3; fi
    wc -l <"$p" >>"$RAW/clam.done.$id"
  done
  return 0
}

mod_malware() {
  need clamscan malware "clamav clamav-freshclam" || return 0
  if ! systemctl is-active -q clamav-freshclam 2>/dev/null; then
    freshclam --quiet >"$RAW/freshclam.log" 2>&1 || add NIEDRIG malware "ClamAV-Signaturupdate fehlgeschlagen" "Log: $RAW/freshclam.log"
  fi
  # (Alter der Signaturen prüft der Bereich „Prüfwerkzeuge“)

  # 1. Dateiliste erstellen – mit allen Ausnahmen, ohne Netzlaufwerke und Pseudo-Dateisysteme
  local paths p roots=() prune=() e
  if [ "$MODE" = full ]; then paths="$CLAM_PATHS_FULL /dev/shm"; else paths=$CLAM_PATHS_QUICK; fi
  # Schnellscan nur über geänderte Dateien: Seit dem letzten vollständigen Virenscan (Marke) neue oder geänderte
  # Dateien im ganzen System. Maßgeblich ist ctime – die setzt das Dateisystem selbst, sie lässt sich nicht wie das
  # Änderungsdatum zurückdatieren. Der Vollscan prüft weiter alles (neue Signaturen erkennen auch alte Dateien).
  local mark=$STATE_DIR/clam-last-complete incr=0 since="" newer=() t0
  t0=$(date +%s)
  if [ "$MODE" != full ] && [ "${CLAM_QUICK_CHANGED:-1}" = 1 ] && [ -f "$mark" ] && [ -z "$(find "$mark" -mmin +20160 2>/dev/null)" ]; then
    incr=1; paths="$CLAM_PATHS_FULL /dev/shm"; since=$(date -r "$mark" '+%d.%m.%Y %H:%M'); newer=(-cnewer "$mark")
  fi
  for p in $paths; do [ -e "$p" ] && roots+=("$p"); done
  clam_excludes | sort -u >"$RAW/clam-excludes.txt"
  while IFS= read -r e; do [ -n "$e" ] && prune+=(-path "$e" -o); done <"$RAW/clam-excludes.txt"
  SUB_TEXT="Dateiliste wird erstellt …"; SUB_START=$(date +%s); write_status true malware "$MOD_I" "$MOD_N"
  log "   Erstelle Dateiliste für den Virenscan …"
  find "${roots[@]}" \( "${prune[@]}" -fstype proc -o -fstype sysfs -o -fstype devtmpfs -o -fstype devpts \
       -o -fstype cgroup -o -fstype cgroup2 -o -fstype squashfs -o -fstype overlay -o -fstype autofs \
       -o -fstype nfs -o -fstype nfs4 -o -fstype cifs -o -fstype smb3 -o -fstype fuse.sshfs -o -fstype fuse.lxcfs \
       -o -fstype fuse.s3fs -o -fstype davfs \) -prune -o -type f -size -"${CLAM_MAX_FILESIZE%M}"M "${newer[@]}" -print 2>/dev/null \
    | awk '!seen[$0]++' >"$RAW/clam.list"
  local total; total=$(wc -l <"$RAW/clam.list")

  # 2. Prüfen: über den laufenden ClamAV-Dienst oder mit eigenen clamscan-Prozessen
  local engine n; engine=$(clam_engine); n=$(clam_workers "$engine")
  (( n > total )) && n=$(( total > 0 ? total : 1 ))
  rm -f "$RAW"/clam.chunk.* "$RAW"/clam.part.* "$RAW"/clam.out.* "$RAW"/clam.err.* "$RAW"/clam.done.*
  SUB_TOTAL=$total; SUB_DONE=0; SUB_TEXT=""; SUB_START=$(date +%s); write_status true malware "$MOD_I" "$MOD_N"
  local pids=() ids=() c id w
  if [ "$engine" = clamd ]; then
    # kleine Teillisten (je 500 Dateien), reihum auf die Prüfstränge verteilt
    log "   ClamAV-Dienst prüft $total Dateien mit $n parallelen Prüfungen …"
    split -l 500 -d -a 6 "$RAW/clam.list" "$RAW/clam.part."
    local parts=("$RAW"/clam.part.*) mine k
    [ -e "${parts[0]}" ] || parts=()
    for (( w = 0; w < n; w++ )); do
      id=$(printf '%02d' "$w"); mine=()
      for (( k = w; k < ${#parts[@]}; k += n )); do mine+=("${parts[$k]}"); done
      (( ${#mine[@]} > 0 )) || continue
      printf '%s\n' "${mine[@]}" | xargs cat >"$RAW/clam.chunk.$id"   # für ein mögliches Nachholen
      clamd_worker "$id" "${mine[@]}" &
      pids+=($!); ids+=("$id")
    done
  else
    # auf parallele clamscan-Prozesse verteilen (reihum, damit alle ähnlich viel Arbeit haben)
    log "   ClamAV prüft $total Dateien mit $n Prozess(en) …"
    split -n "r/$n" -d -a 2 "$RAW/clam.list" "$RAW/clam.chunk."
    for c in "$RAW"/clam.chunk.*; do
      [ -s "$c" ] || continue
      id=${c##*.}
      nice -n 19 ionice -c3 clamscan --no-summary --max-filesize="$CLAM_MAX_FILESIZE" --max-scansize=400M \
        -f "$c" >"$RAW/clam.out.$id" 2>"$RAW/clam.err.$id" &
      pids+=($!); ids+=("$id")
    done
  fi
  clam_progress & local prog=$!

  # 3. Warten und Ergebnisse auswerten (Abbruch per Signal greift hier sofort)
  local rc=0 r i killed=() failed=() retried=0
  for i in "${!pids[@]}"; do
    r=0; wait "${pids[$i]}" || r=$?
    if (( r > 128 )); then killed+=("${ids[$i]}")
    elif [ "$engine" = clamd ] && (( r == 3 )); then failed+=("${ids[$i]}")
    elif [ "$engine" = clamscan ] && (( r > rc )); then rc=$r; fi
  done
  # Teil-Scans, die das System beendet hat (meist Speichermangel) oder bei denen der ClamAV-Dienst
  # ausgefallen ist: fehlende Dateien mit einem einzelnen clamscan-Prozess nachholen
  if (( ${#killed[@]} + ${#failed[@]} > 0 )); then
    : >"$RAW/clam.retry"
    for id in "${killed[@]}" "${failed[@]}"; do
      awk 'NR==FNR { sub(/: [^:]*$/, ""); done[$0] = 1; next } !($0 in done)' \
        "$RAW/clam.out.$id" "$RAW/clam.chunk.$id" >>"$RAW/clam.retry"
    done
    rm -f "$RAW"/clam.done.*
    retried=$(wc -l <"$RAW/clam.retry")
    log "   $(( ${#killed[@]} + ${#failed[@]} )) Teil-Scan(s) nicht fertig geworden – prüfe $retried Dateien mit clamscan nach …"
    SUB_TEXT="Hole $retried Dateien nach …"
    r=0
    nice -n 19 ionice -c3 clamscan --no-summary --max-filesize="$CLAM_MAX_FILESIZE" --max-scansize=400M \
      -f "$RAW/clam.retry" >"$RAW/clam.out.retry" 2>"$RAW/clam.err.retry" &
    wait $! || r=$?
    (( r > rc )) && rc=$r
    rm -f "$RAW/clam.retry"
  fi
  # Dateien, die der ClamAV-Dienst nicht lesen konnte (z. B. wegen AppArmor), mit clamscan nachholen;
  # während des Scans gelöschte Dateien zählen nicht
  local unread=0
  if [ "$engine" = clamd ]; then
    cat "$RAW"/clam.out.[0-9]* 2>/dev/null | grep ' ERROR$' | grep -viE "$CLAM_GONE_RX" \
      | sed -E 's/: [^:]* ERROR$//' >"$RAW/clam.retry2"
    unread=$(grep -c . "$RAW/clam.retry2")
    if (( unread > 0 )); then
      log "   $unread Dateien konnte der ClamAV-Dienst nicht lesen – prüfe sie mit clamscan …"
      SUB_TEXT="Prüfe $unread Dateien mit clamscan nach …"
      r=0
      nice -n 19 ionice -c3 clamscan --no-summary --max-filesize="$CLAM_MAX_FILESIZE" --max-scansize=400M \
        -f "$RAW/clam.retry2" >"$RAW/clam.out.retry2" 2>"$RAW/clam.err.retry2" &
      wait $! || r=$?
      (( r > 128 )) && rc=$r
    fi
    rm -f "$RAW/clam.retry2"
  fi
  kill "$prog" 2>/dev/null; wait "$prog" 2>/dev/null
  SUB_DONE=$(clam_count); write_status true malware "$MOD_I" "$MOD_N"
  cat "$RAW"/clam.out.* 2>/dev/null | grep ' FOUND$' | sed 's/ FOUND$//' >"$RAW/clam-found.txt"
  # „Heuristics.Limits.Exceeded“ (nur mit AlertExceedsMax) ist kein Virus, sondern eine zu große Datei
  grep -v 'Heuristics\.Limits\.Exceeded' "$RAW/clam-found.txt" >"$RAW/clam-hits.txt"
  grep -c 'Heuristics\.Limits\.Exceeded' "$RAW/clam-found.txt" >"$RAW/clam-limits.txt"
  cat "$RAW"/clam.out.* 2>/dev/null | grep ' ERROR$' >"$RAW/clam-errors.txt"
  cat "$RAW"/clam.err.* 2>/dev/null | grep -v '^$' >"$RAW/clamscan.err"
  rm -f "$RAW"/clam.chunk.* "$RAW"/clam.part.* "$RAW"/clam.out.* "$RAW"/clam.err.* "$RAW"/clam.done.* "$RAW/clam.list" "$RAW/clam-found.txt"

  # Testdateien des Pakets clamav-testfiles sind absichtlich „infiziert“ (harmlose Prüfmuster).
  # Nur als harmlos werten, wenn sie im Paketordner liegen, die Testsignatur tragen und das Paket unverändert ist.
  local tf=0
  if grep -q '^/usr/share/clamav-testfiles/' "$RAW/clam-hits.txt" && dpkg -s clamav-testfiles >/dev/null 2>&1 \
     && [ -z "$(dpkg --verify clamav-testfiles 2>/dev/null)" ]; then
    tf=$(grep -ciE '^/usr/share/clamav-testfiles/[^/]+: (Clamav\.Test\.File-[0-9]+|[A-Za-z.]*EICAR[A-Za-z0-9_.-]*)$' "$RAW/clam-hits.txt")
    grep -viE '^/usr/share/clamav-testfiles/[^/]+: (Clamav\.Test\.File-[0-9]+|[A-Za-z.]*EICAR[A-Za-z0-9_.-]*)$' "$RAW/clam-hits.txt" >"$RAW/clam-hits.n"
    mv -f "$RAW/clam-hits.n" "$RAW/clam-hits.txt"
  fi
  (( tf > 0 )) && add INFO malware "ClamAV: $tf Testdateien des Pakets clamav-testfiles erkannt (harmlos)" \
    "/usr/share/clamav-testfiles/ – absichtlich präparierte Prüfmuster, mit denen sich ClamAV selbst testet; Paketdateien unverändert" \
    "Nicht nötig für den Betrieb; entfernen mit: sudo apt remove clamav-testfiles"
  local hits dur=$(( $(date +%s) - SUB_START ))
  hits=$(grep -c . "$RAW/clam-hits.txt")
  if (( hits > 0 )); then take "$RAW/clam-hits.txt" 15
    add KRITISCH malware "ClamAV: $hits infizierte Dateien gefunden" "${ITEMS[@]}" "Nicht automatisch gelöscht – bitte prüfen und entfernen"
  fi
  # clamscan: 0 = sauber, 1 = Funde, 2 = Fehler, >128 = durch Signal beendet
  if (( rc >= 2 )); then
    add MITTEL malware "ClamAV-Virenscan abgebrochen oder fehlgeschlagen – Ergebnis unvollständig" \
      "Rückgabewert $rc$( (( rc > 128 )) && echo " (beendet durch Signal $((rc - 128)))")" \
      "Geprüft: $SUB_DONE von $total Dateien" "Log: $RAW/clamscan.err"
  elif (( hits == 0 )); then
    add INFO malware "ClamAV: keine Funde in $total Dateien"
  fi
  if (( ${#killed[@]} > 0 )); then
    add NIEDRIG malware "Virenscan-Prozesse wegen Speichermangel beendet – Dateien wurden nachgeholt" \
      "${#killed[@]} von $n Prozessen vom System beendet, $retried Dateien einzeln nachgeprüft" \
      "Empfehlung: Einstellungen → Scan-Einstellungen → weniger parallele Virenscan-Prozesse"
  fi
  if (( ${#failed[@]} > 0 )); then
    add NIEDRIG malware "ClamAV-Dienst während des Virenscans nicht erreichbar – Dateien mit clamscan nachgeholt" \
      "$retried Dateien mit einem eigenen clamscan-Prozess nachgeprüft" \
      "Prüfen: systemctl status clamav-daemon; journalctl -u clamav-daemon -n 50"
  fi
  local gone; gone=$(grep -ciE "$CLAM_GONE_RX" "$RAW/clam-errors.txt")
  local lim; lim=$(cat "$RAW/clam-limits.txt" 2>/dev/null); lim=${lim:-0}
  local ex=0
  while IFS= read -r e; do
    [[ $e =~ ^(/proc|/sys|/dev|/run|/snap|/var/lib/(docker|containerd|lxcfs|clamav)|/swapfile|/swap\.img)$ ]] && continue
    [ "$e" = "$LOG_DIR" ] || [ "$e" = "$STATE_DIR" ] || { [ -e "$e" ] && ex=$((ex+1)); }
  done <"$RAW/clam-excludes.txt"
  # Marke setzen, wenn alle Dateien (Vollscan) bzw. alle geänderten Dateien (Schnellscan) vollständig und ohne Fund
  # geprüft wurden – bei einem Fund bleibt die Marke stehen, damit die Datei bei jedem Schnellscan wieder gemeldet wird
  if (( rc < 2 && hits == 0 )) && { [ "$MODE" = full ] || (( incr )); }; then
    touch -d "@$t0" "$mark"
    [ "$MODE" = full ] && touch -d "@$t0" "$STATE_DIR/clam-last-full"
  fi
  if [ "$MODE" != full ]; then
    local lf=$STATE_DIR/clam-last-full days
    if [ -f "$lf" ]; then days=$(( ( $(date +%s) - $(stat -c %Y "$lf") ) / 86400 ))
      (( days > 10 )) && add NIEDRIG malware "Letzter vollständiger Virenscan vor $days Tagen" \
        "Nur der Vollscan prüft alle Dateien mit den neuesten Signaturen" "Starten: Weboberfläche → Scan starten → Vollscan"
    fi
  fi
  local how="mit $n Prozess(en)" size="Größere Dateien als $CLAM_MAX_FILESIZE werden übersprungen"
  if [ "$engine" = clamd ]; then
    how="über den ClamAV-Dienst ($n parallele Prüfungen)"
    local mfs; mfs=$(clamd_conf MaxFileSize)
    size="Größere Dateien als $CLAM_MAX_FILESIZE werden übersprungen; der ClamAV-Dienst prüft Dateien bis ${mfs:-100M} (MaxFileSize in /etc/clamav/clamd.conf)"
  fi
  local extra=()
  (( unread > 0 )) && extra+=("$unread Dateien konnte der ClamAV-Dienst nicht lesen; sie wurden mit clamscan geprüft (Liste: $RAW/clam-errors.txt)")
  (( gone > 0 )) && extra+=("$gone Dateien wurden während des Scans gelöscht oder verschoben (normal bei temporären Dateien)")
  (( lim > 0 )) && extra+=("$lim Dateien überschreiten die Größen- oder Entpackgrenzen des ClamAV-Dienstes und wurden nur teilweise geprüft")
  local what="$total Dateien"
  if (( incr )); then what="$total seit $since neue oder geänderte Dateien"
    extra+=("Schnellscan prüft nur geänderte Dateien (Einstellung „Schnellscan: nur geänderte Dateien“); der Vollscan prüft alle")
  elif [ "$MODE" != full ] && [ "${CLAM_QUICK_CHANGED:-1}" = 1 ]; then
    extra+=("Noch kein vollständiger Virenscan als Ausgangspunkt – ab dem ersten Vollscan prüft der Schnellscan nur geänderte Dateien im ganzen System")
  fi
  add INFO malware "Virenscan: $what $how in $(fmt_dur "$dur") geprüft" \
    "Durchsucht: ${roots[*]}" "Ausgenommen: $ex Ordner (Liste: $RAW/clam-excludes.txt)" "$size" "${extra[@]}"
}

# ============================================================================
#  MODUL: web – Webshells, PHP in Upload-Ordnern, Linux Malware Detect
# ============================================================================
run_heartbeat() { # run_heartbeat "Text" befehl … – zeigt während langer Schritte „Text – läuft seit N Min.“ an
  local txt=$1 pid t0; shift
  t0=$(date +%s); SUB_TOTAL=0; SUB_DONE=0; SUB_START=$t0
  SUB_TEXT="$txt"; write_status true "$CUR_MOD" "$MOD_I" "$MOD_N"
  "$@" & pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    sleep 10
    local el=$(( $(date +%s) - t0 ))
    if (( el < 60 )); then SUB_TEXT="$txt – läuft seit $el s"; else SUB_TEXT="$txt – läuft seit $(( el / 60 )) Min."; fi
    write_status true "$CUR_MOD" "$MOD_I" "$MOD_N"
  done
  wait "$pid"
}

mod_web() {
  local roots=() p
  for p in $WEB_PATHS; do [ -d "$p" ] && roots+=("$p"); done
  [ ${#roots[@]} -eq 0 ] && return 0

  # Nextcloud-Datenordner sind Ablagen der Benutzer (gespeicherte Webseiten, Updater-Sicherungen) und werden vom
  # Webserver nicht ausgeführt – hier nicht durchsuchen (der Virenscan prüft sie weiterhin)
  local prune=() d
  while IFS= read -r d; do [ -n "$d" ] && prune+=(-path "$d" -o); done < <(nextcloud_datadirs)
  # Upload-Orte: wp-content/uploads, Drupal sites/*/files, Mautic media/files und allgemein uploads/, images/, files/ –
  # aber nicht in Programmcode (Plugins, Themes, vendor, Nextcloud-Apps …), wo Ordner zufällig so heißen
  SUB_TEXT="Suche PHP-Dateien in Upload-Ordnern …"; SUB_START=$(date +%s); write_status true "$CUR_MOD" "$MOD_I" "$MOD_N"
  find "${roots[@]}" -xdev \( "${prune[@]}" -false \) -prune -o \
    \( -path '*/wp-content/uploads/*' -o -path '*/sites/*/files/*' -o -path '*/media/files/*' -o -path '*/uploads/*' \
       -o -path '*/upload/*' -o -path '*/images/*' -o -path '*/files/*' \) \
    ! -path '*/wp-content/plugins/*' ! -path '*/wp-content/themes/*' ! -path '*/vendor/*' ! -path '*/node_modules/*' \
    ! -path '*/apps/*' ! -path '*/custom_apps/*' ! -path '*/apps-extra/*' ! -path '*/core/*' ! -path '*/lib/*' \
    ! -path '*/src/*' ! -path '*/app/*' ! -path '*/libraries/*' ! -path '*/modules/*' \
    -type f -iname '*.ph*' ! -name '*.phpx' -print 2>/dev/null >"$RAW/web-php-uploads.all"
  # Einordnen: von Plugins erzeugte Dateien (MailPoet-Vorlagen-Cache, Matomo-Konfiguration), leere Platzhalter und
  # Dateien mit Zugriffsschutz in der ersten Zeile sind harmlos; der Rest wird gemeldet – milder, wenn die
  # PHP-Ausführung im Upload-Ordner per .htaccess gesperrt ist
  python3 -I - "$RAW/web-php-uploads.all" >"$RAW/web-php-uploads.class" 2>/dev/null <<'PY2'
import os, re, sys
DENY = re.compile(r"(?i)(php_flag\s+engine\s+off|Require all denied|Deny from all|SetHandler\s+none)")
SUS = re.compile(r"(?i)eval\s*\(|base64_decode|gzinflate|str_rot13|assert\s*\(\s*\$|\b(system|passthru|shell_exec|exec|popen|proc_open)\s*\(|"
                 r"\$_(GET|POST|REQUEST|COOKIE|FILES)|move_uploaded_file|file_put_contents|fsockopen|curl_exec")
def head(p, n=4096):
    try:
        with open(p, "rb") as f:
            return f.read(n).decode("utf-8", "replace")
    except OSError:
        return ""
def locked(p):
    d = os.path.dirname(p)
    while d and d != "/":
        h = os.path.join(d, ".htaccess")
        if os.path.isfile(h) and DENY.search(head(h, 65536)):
            return True
        if os.path.basename(d) in ("uploads", "files", "media", "images", "upload"):
            break
        d = os.path.dirname(d)
    return False
for line in open(sys.argv[1], errors="replace"):
    p = line.rstrip("\n")
    t = head(p)
    body = re.sub(r"/\*.*?\*/|//[^\n]*|#[^\n]*|\s", "", t, flags=re.S)
    body = re.sub(r"^<\?php|\?>$", "", body)
    first = next((l.strip() for l in t.splitlines() if l.strip()), "")
    full = head(p, 1 << 20)
    # verdächtige Befehle schließen jede „harmlos“-Einordnung aus (z. B. eine Webshell mit Twig-Kopf getarnt)
    if SUS.search(full):
        print("UNK\t%s\t%s" % ("gesperrt" if locked(p) else "offen", p))
        continue
    if os.path.getsize(p) < 200 and not body:
        why = "leerer Platzhalter"
    elif "/wp-content/uploads/mailpoet/cache/" in p and re.search(r"Twig\\(Environment|Template|Error|Source)|__TwigTemplate_", t):
        why = "MailPoet-Vorlagen-Cache"
    elif re.search(r"/uploads/matomo/config/[^/]+\.ini\.php$", p) and re.search(r"exit|die", first):
        why = "Matomo-Konfiguration (mit Zugriffsschutz)"
    elif re.match(r"^(;\s*)?<\?php\s*(exit|die)\b|^<\?php\s*(defined|if)\s*\(\s*!?\s*defined\(\s*['\"]ABSPATH['\"]\s*\)", first):
        why = "Zugriffsschutz in der ersten Zeile"
    else:
        print("UNK\t%s\t%s" % ("gesperrt" if locked(p) else "offen", p))
        continue
    print("OK\t%s\t%s" % (why, p))
PY2
  grep -P '^UNK\toffen\t' "$RAW/web-php-uploads.class" | cut -f3 >"$RAW/web-php-uploads.txt"
  grep -P '^UNK\tgesperrt\t' "$RAW/web-php-uploads.class" | cut -f3 >"$RAW/web-php-uploads-locked.txt"
  grep -P '^OK\t' "$RAW/web-php-uploads.class" | awk -F'\t' '$2 != "leerer Platzhalter" {print $3 " – " $2}' >"$RAW/web-php-uploads-known.txt"
  if [ -s "$RAW/web-php-uploads.txt" ]; then take "$RAW/web-php-uploads.txt" 10
    add HOCH web "PHP-Dateien in Upload-/Medienordnern (häufiges Webshell-Versteck)" "${ITEMS[@]}"
  fi
  if [ -s "$RAW/web-php-uploads-locked.txt" ]; then take "$RAW/web-php-uploads-locked.txt" 10
    add MITTEL web "PHP-Dateien in Upload-Ordnern (Ausführung per .htaccess gesperrt)" "${ITEMS[@]}" \
      "Über den Webserver nicht aufrufbar; trotzdem prüfen, woher sie stammen"
  fi
  if [ -s "$RAW/web-php-uploads-known.txt" ]; then take "$RAW/web-php-uploads-known.txt" 6
    add INFO web "$(grep -c . "$RAW/web-php-uploads-known.txt") von Plugins erzeugte PHP-Dateien in Upload-Ordnern erkannt (harmlos)" "${ITEMS[@]}" \
      "z. B. MailPoet legt dort seinen Vorlagen-Cache an, Matomo seine Konfiguration – beide werden nur intern eingelesen"
  fi

  # Webshell-Muster in allen PHP-Dateien – in Paketen zu je 2000 Dateien, damit die Weboberfläche den Fortschritt zeigt
  SUB_TEXT="Erfasse PHP-Dateien der Websites …"; SUB_START=$(date +%s); write_status true "$CUR_MOD" "$MOD_I" "$MOD_N"
  find "${roots[@]}" -xdev \( "${prune[@]}" -false \) -prune -o -type f \( -name '*.php' -o -name '*.phtml' -o -name '*.php[0-9]' \) -print 2>/dev/null >"$RAW/web-php-all.txt"
  local wpat chunk
  wpat=$(cat <<'WPAT'
eval[[:space:]]*\([[:space:]]*(base64_decode|gzinflate|gzuncompress|str_rot13|strrev)[[:space:]]*\(|assert[[:space:]]*\([[:space:]]*\$_(POST|GET|REQUEST|COOKIE)|(system|passthru|shell_exec|exec|popen|proc_open)[[:space:]]*\([[:space:]]*\$_(GET|POST|REQUEST|COOKIE)|\$_(POST|GET|REQUEST|COOKIE)\[[^]]+\][[:space:]]*\(|FilesMan|c99shell|r57shell|b374k|WSO [0-9]|\$GLOBALS\[.{0,40}\]\[[0-9]+\]\(
WPAT
)
  SUB_TOTAL=$(grep -c . "$RAW/web-php-all.txt"); SUB_DONE=0; SUB_START=$(date +%s)
  SUB_TEXT="Suche Webshell-Muster in PHP-Dateien"; write_status true "$CUR_MOD" "$MOD_I" "$MOD_N"
  : >"$RAW/web-shell-sig.txt"
  rm -f "$RAW"/web-php-chunk.*
  split -l 2000 -d -a 5 "$RAW/web-php-all.txt" "$RAW/web-php-chunk."
  for chunk in "$RAW"/web-php-chunk.*; do
    [ -f "$chunk" ] || continue
    tr '\n' '\0' <"$chunk" | xargs -0 -r grep -IlsE "$wpat" 2>/dev/null >>"$RAW/web-shell-sig.txt"
    SUB_DONE=$(( SUB_DONE + $(grep -c . "$chunk") )); rm -f "$chunk"
    write_status true "$CUR_MOD" "$MOD_I" "$MOD_N"
  done
  SUB_TOTAL=0; SUB_DONE=0
  # Treffer in Testcode von Anwendungen (…/Tests/…, …/tests/…) sind fast immer Testdaten – getrennt und milder melden
  grep -E '/[Tt]ests?/' "$RAW/web-shell-sig.txt" >"$RAW/web-shell-sig-tests.txt"
  grep -vE '/[Tt]ests?/' "$RAW/web-shell-sig.txt" >"$RAW/web-shell-sig.main.txt"; mv -f "$RAW/web-shell-sig.main.txt" "$RAW/web-shell-sig.txt"
  if [ -s "$RAW/web-shell-sig.txt" ]; then take "$RAW/web-shell-sig.txt" 10
    add HOCH web "$(grep -c . "$RAW/web-shell-sig.txt") PHP-Dateien mit typischen Webshell-Mustern" "${ITEMS[@]}" "Einzeln prüfen – vereinzelt auch in legitimen Plugins"
  fi
  if [ -s "$RAW/web-shell-sig-tests.txt" ]; then take "$RAW/web-shell-sig-tests.txt" 10
    add MITTEL web "$(grep -c . "$RAW/web-shell-sig-tests.txt") PHP-Testdateien von Anwendungen mit Webshell-Mustern (meist Testdaten)" "${ITEMS[@]}" \
      "Liegen in Test-Ordnern der Anwendung; Testcode enthält solche Muster oft absichtlich – mit „Jetzt prüfen“ ansehen"
  fi

  if have maldet; then
    # maldet an ubusec angleichen: dieselben Ausnahmen wie beim Virenscan (Nextcloud-Daten, Backups, Datenbanken …)
    # und /tmp nicht mitdurchsuchen – dort entpackt z. B. Collabora Online Zehntausende eigene Dateien, und /tmp
    # prüfen ClamAV und die Prozess-Prüfung von ubusec bereits. /var/tmp und /dev/shm bleiben drin.
    local mconf=/usr/local/maldetect/conf.maldet mign=/usr/local/maldetect/ignore_paths
    if [ -f "$mconf" ]; then
      if grep -q '^scan_tmpdir_paths=' "$mconf"; then sed -i 's|^scan_tmpdir_paths=.*|scan_tmpdir_paths="/var/tmp /dev/shm"|' "$mconf"
      else echo 'scan_tmpdir_paths="/var/tmp /dev/shm"' >>"$mconf"; fi
      { cat "$mign" 2>/dev/null; clam_excludes; } | grep '^/' | sort -u >"$mign.new" && mv -f "$mign.new" "$mign"
    fi
    # Schnellscan: nur Dateien der letzten 2 Tage (maldet -r); Vollscan: alles (maldet -a) – je Ordner einzeln,
    # maldet versteht keine durch Komma getrennte Liste (bis 1.5.12 wurde dadurch nur /tmp durchsucht)
    local r days=2 mw=auto
    # Parallele Prüfungen: Einstellung „Parallele Prüfungen“ übernehmen (maldet erlaubt höchstens 8);
    # „Automatisch“ überlässt es maldet (2 je CPU-Kern, höchstens 8). Läuft der ClamAV-Dienst, nutzt maldet ihn selbst.
    if [ "${CLAM_PARALLEL:-0}" -gt 0 ] 2>/dev/null; then mw=$(( CLAM_PARALLEL > 8 ? 8 : CLAM_PARALLEL )); fi
    : >"$RAW/maldet.txt"
    for r in "${roots[@]}"; do
      if [ "$MODE" = full ]; then
        log "   Linux Malware Detect durchsucht: $r (vollständig)"
        run_heartbeat "Linux Malware Detect durchsucht $r vollständig" nice -n 19 maldet -co "scan_workers=$mw" -a "$r" >>"$RAW/maldet.txt" 2>&1
      else
        log "   Linux Malware Detect durchsucht: $r (Dateien der letzten $days Tage)"
        run_heartbeat "Linux Malware Detect prüft in $r die Dateien der letzten $days Tage" \
          nice -n 19 maldet -co "scan_workers=$mw" -r "$r" "$days" >>"$RAW/maldet.txt" 2>&1
      fi
    done
    SUB_TEXT=""
    local hits rep
    hits=$(grep -oE 'malware hits [0-9]+' "$RAW/maldet.txt" | grep -oE '[0-9]+' | awk '{s+=$1} END{print s+0}')
    rep=$(grep -oE 'maldet --report [0-9.-]+' "$RAW/maldet.txt" | tail -1)
    if [ "${hits:-0}" -gt 0 ]; then add KRITISCH web "Linux Malware Detect: $hits Funde" "Bericht: $rep"
    else add INFO web "Linux Malware Detect: keine Funde"; fi
  else
    add INFO web "Tipp: Linux Malware Detect (maldet) erkennt Web-Malware besser als ClamAV allein" "Installieren: Weboberfläche → Werkzeuge → „Linux Malware Detect installieren“"
  fi
}

# ============================================================================
#  MODULE: sites / apps – Websites, Domains und Webanwendungen (webcheck.py)
# ============================================================================
run_webcheck() {
  local dir=$CHECK_DIR
  [ -f "$dir/webcheck.py" ] || dir=$SRC_DIR/checks
  if [ ! -f "$dir/webcheck.py" ]; then
    add NIEDRIG "$1" "Prüfprogramm webcheck.py fehlt" "Neu installieren: sudo ./ubusec --install"; return 0
  fi
  local cvef=0; [[ " ${RUN_MODULES:-} " == *" cve "* ]] && cvef=1
  UBUSEC_CVE_FOLLOWS=$cvef SITES_EXCLUDE="$SITES_EXCLUDE" SITES_EXTRA="$SITES_EXTRA" SITES_TESTSSL="$SITES_TESTSSL" \
  WPSCAN_API_TOKEN="$WPSCAN_API_TOKEN" UBUSEC_WPSCAN_FORCE="${UBUSEC_WPSCAN_FORCE:-0}" WEB_PATHS="$WEB_PATHS" RAW="$RAW" STATE_DIR="$STATE_DIR" \
  UBUSEC_VERSION="$UBUSEC_VERSION" UBUSEC_REPO="$UBUSEC_REPO" UPDATE_CHECK="$UPDATE_CHECK" TOOLS_JSON="$STATE_DIR/tools.json" \
    timeout 4h python3 -I "$dir/webcheck.py" "$1" --raw "$RAW" --mode "$MODE" >"$RAW/$1.tsv" 2>"$RAW/$1.err"
  local sev msg det arr
  while IFS=$'\t' read -r sev msg det; do
    [ -n "${RANK[$sev]+x}" ] || continue
    arr=(); [ -n "$det" ] && IFS=$'\x1f' read -r -a arr <<<"$det"
    add "$sev" "$1" "$msg" "${arr[@]}"
  done <"$RAW/$1.tsv"
  [ -s "$RAW/$1.err" ] && grep -q Traceback "$RAW/$1.err" && add NIEDRIG "$1" "Teilprüfung mit Programmfehler" "Log: $RAW/$1.err"
  return 0
}
mod_sites() { run_webcheck sites; }
mod_apps()  { run_webcheck apps; }
mod_tools() {
  run_webcheck tools
  [ -f "$STATE_DIR/tools.json" ] && { chgrp "$(grp)" "$STATE_DIR/tools.json"; chmod 640 "$STATE_DIR/tools.json"; }
  return 0
}

