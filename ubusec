write_units() {
  cat >/etc/systemd/system/ubusec-quick.service <<EOF
[Unit]
Description=ubusec – Schnellscan (Updates, CVEs, Rootkits, Malware)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=$INSTALL_PATH --quick --quiet --trigger timer
Nice=19
IOSchedulingClass=idle
CPUWeight=20
# Speicherschutz: Scans dürfen höchstens 40 % des Arbeitsspeichers belegen (mindestens 2,5 GB,
# höchstens 75 %) und nie in den Swap ausweichen (der bleibt für Webserver und Datenbank).
# Wird es eng, trifft es den Scanner, und ein beendeter Teilprozess bricht nicht den ganzen Scan ab.
MemoryMax=$(scan_mem_limit_mb)M
MemorySwapMax=0
OOMScoreAdjust=500
OOMPolicy=continue
TimeoutStartSec=6h
EOF
  cat >/etc/systemd/system/ubusec-quick.timer <<'EOF'
[Unit]
Description=ubusec Schnellscan Mo–Sa

[Timer]
OnCalendar=Mon..Sat *-*-* 03:17
RandomizedDelaySec=20m
Persistent=true

[Install]
WantedBy=timers.target
EOF
  sed -e 's/Schnellscan (Updates, CVEs, Rootkits, Malware)/Vollscan (alle Module)/' \
      -e 's/--quick/--full/' -e 's/TimeoutStartSec=6h/TimeoutStartSec=14h/' \
      /etc/systemd/system/ubusec-quick.service >/etc/systemd/system/ubusec-full.service
  cat >/etc/systemd/system/ubusec-full.timer <<'EOF'
[Unit]
Description=ubusec Vollscan sonntags

[Timer]
OnCalendar=Sun *-*-* 03:17
RandomizedDelaySec=20m
Persistent=true

[Install]
WantedBy=timers.target
EOF
}

write_conf() {
  [ -f "$CONF_FILE" ] && return 0
  mkdir -p "$CONF_DIR"
  cat >"$CONF_FILE" <<EOF
# ubusec – Konfiguration (Bash-Syntax)

# Benachrichtigung: E-Mail (benötigt mailutils/bsd-mailx oder sendmail) und/oder ntfy-URL
MAIL_TO=""
NTFY_URL=""                 # z.B. https://ntfy.sh/mein-geheimes-thema
NOTIFY_MIN="HOCH"           # ab welcher Schwere benachrichtigt wird
NOTIFY_ONLY_NEW=1           # nur bei neuen Meldungen (verhindert tägliche Wiederholung)

# ClamAV-Suchpfade
CLAM_PATHS_QUICK="$CLAM_PATHS_QUICK"
CLAM_PATHS_FULL="$CLAM_PATHS_FULL"
CLAM_EXCLUDE_DIRS="$CLAM_EXCLUDE_DIRS"
CLAM_MAX_FILESIZE="$CLAM_MAX_FILESIZE"

# Webroots für Webshell-Suche (Virtualmin: /home)
WEB_PATHS="$WEB_PATHS"

# Ports, die öffentlich lauschend gemeldet werden
RISKY_PORTS_HIGH="$RISKY_PORTS_HIGH"
RISKY_PORTS_MED="$RISKY_PORTS_MED"

# Aufbewahrung der Berichte in Tagen
KEEP_DAYS=$KEEP_DAYS
EOF
  cat >"$IGNORE_FILE" <<'EOF'
# ubusec – bekannte Fehlalarme ausblenden
# Eine erweiterte Regex pro Zeile; geprüft wird gegen "modul|meldung|details".
# Beispiele:
#   ^rootkit\|rkhunter: .*/usr/bin/lwp-request
#   ^firewall\|Admin-/Web-Oberflächen.*10000/tcp
EOF
}

configure_rkhunter() {
  [ -f /etc/rkhunter.conf ] || return 0
  local wl="" f
  for f in /usr/bin/egrep /usr/bin/fgrep /usr/bin/which /usr/bin/ldd /usr/bin/lwp-request; do
    [ -f "$f" ] && wl+="SCRIPTWHITELIST=$f"$'\n'
  done
  cat >/etc/rkhunter.conf.local <<EOF
# von ubusec angelegt
UPDATE_MIRRORS=1
MIRRORS_MODE=0
WEB_CMD=""
PKGMGR=DPKG
$wl
EOF
  if [ -f /etc/default/rkhunter ]; then
    sed -i -e 's/^CRON_DAILY_RUN=.*/CRON_DAILY_RUN="false"/' \
           -e 's/^CRON_DB_UPDATE=.*/CRON_DB_UPDATE="true"/' \
           -e 's/^APT_AUTOGEN=.*/APT_AUTOGEN="true"/' /etc/default/rkhunter
  fi
}

inst_atomic() { install -m 0644 -o root -g root "$1" "$2.new" && mv -f "$2.new" "$2"; }

do_install() {
  local with_aide=$1
  echo "→ Installiere Pakete …"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  local pkgs="lynis rkhunter chkrootkit unhide clamav clamav-freshclam needrestart bzip2 curl python3 distro-info unattended-upgrades bind9-dnsutils"
  [ "$with_aide" = 1 ] && pkgs+=" aide aide-common"
  # shellcheck disable=SC2086
  apt-get install -y -qq --no-install-recommends $pkgs || echo "  Warnung: nicht alle Pakete installierbar"
  apt-get install -y -qq openscap-scanner 2>/dev/null || apt-get install -y -qq libopenscap8 2>/dev/null \
    || echo "  Hinweis: OpenSCAP nicht verfügbar – CVE-Modul wird übersprungen"

  apt-get install -y -qq testssl.sh 2>/dev/null || true
  echo "→ Kopiere ubusec nach $INSTALL_PATH"
  # Atomar ersetzen (neue Datei + mv): Ein gerade laufender Scan liest sein Skript sonst ab der alten Stelle in der
  # NEUEN Datei weiter und bricht mit sinnlosen Fehlern ab (Ubuntus rust-coreutils überschreibt bei install vor Ort)
  [ "$SELF_PATH" != "$INSTALL_PATH" ] && install -m 0750 -o root -g root "$SELF_PATH" "$INSTALL_PATH.new" \
    && mv -f "$INSTALL_PATH.new" "$INSTALL_PATH"
  ensure_dirs
  if [ -f "$SRC_DIR/checks/webcheck.py" ] && [ "$(readlink -f "$SRC_DIR/checks")" != "$CHECK_DIR" ]; then
    install -d -m 0755 /usr/local/lib/ubusec "$CHECK_DIR"; inst_atomic "$SRC_DIR/checks/webcheck.py" "$CHECK_DIR/webcheck.py"
    [ -f "$SRC_DIR/checks/verify.py" ] && inst_atomic "$SRC_DIR/checks/verify.py" "$CHECK_DIR/verify.py"
    [ -f "$SRC_DIR/checks/fix.py" ] && inst_atomic "$SRC_DIR/checks/fix.py" "$CHECK_DIR/fix.py"
    [ -f "$SRC_DIR/checks/sshkeys.py" ] && inst_atomic "$SRC_DIR/checks/sshkeys.py" "$CHECK_DIR/sshkeys.py"
  fi
  write_conf
  configure_rkhunter
  echo "→ Aktualisiere Signaturen (ClamAV, rkhunter) …"
  systemctl stop clamav-freshclam 2>/dev/null; freshclam --quiet 2>/dev/null; systemctl enable --now clamav-freshclam 2>/dev/null
  rkhunter --update --nocolors >/dev/null 2>&1
  # Baseline nur beim ersten Mal anlegen – ein Update darf unbemerkte Änderungen nicht „absegnen“
  if [ -f "$BASE_DIR/.created" ]; then
    echo "→ Bestehende Baseline vom $(cat "$BASE_DIR/.created") bleibt erhalten (neu anlegen: ubusec --accept)"
    [ "$with_aide" = 1 ] && [ ! -f /var/lib/aide/aide.db ] && do_baseline 1
  else
    do_baseline "$with_aide"
  fi
  write_units
  [ -f "$SCHEDULE_FILE" ] || write_schedule
  apply_schedule
  write_settings_json
  cat <<EOF

✔ ubusec installiert.
  Erster Vollscan:     sudo ubusec --full
  Zeitpläne:           Schnellscan Mo–Sa 03:17, Vollscan So 03:17  (systemctl list-timers 'ubusec*')
  Konfiguration:       $CONF_FILE   (E-Mail/ntfy eintragen!)
  Fehlalarme:          $IGNORE_FILE
  Berichte:            $LOG_DIR
EOF
}

do_baseline() {
  local with_aide=${1:-0}
  ensure_dirs
  echo "→ Lege Baseline an (Konten, Ports, SSH-Schlüssel, Cron, Dienste, SUID) …"
  write_baseline
  if have rkhunter; then echo "→ rkhunter --propupd"; rkhunter --propupd --nocolors >/dev/null 2>&1; fi
  if have aideinit && { [ "$with_aide" = 1 ] || [ -f /var/lib/aide/aide.db ]; }; then
    echo "→ AIDE-Datenbank wird erstellt (kann viele Minuten dauern) …"
    aideinit -y -f >/dev/null 2>&1 && [ -f /var/lib/aide/aide.db.new ] && cp /var/lib/aide/aide.db.new /var/lib/aide/aide.db
  fi
  echo "✔ Baseline gespeichert: $(cat "$BASE_DIR/.created")"
}

do_uninstall() {
  systemctl disable --now ubusec-quick.timer ubusec-full.timer ubusec-web.service ubusec-queue.path ubusec-ctl.path 2>/dev/null
  rm -f /etc/systemd/system/ubusec-{quick,full}.{service,timer} /etc/systemd/system/ubusec-web.service \
        /etc/systemd/system/ubusec-queue.{path,service} /etc/systemd/system/ubusec-ctl.{path,service} "$INSTALL_PATH"
  rm -rf /etc/systemd/system/ubusec-{quick,full}.timer.d /usr/local/lib/ubusec/checks
  rm -rf "$WEB_DIR"
  systemctl daemon-reload
  echo "ubusec entfernt. Konfiguration ($CONF_DIR), Daten ($STATE_DIR) und Berichte ($LOG_DIR) blieben erhalten."
}

# Aufträge der Weboberfläche abarbeiten. Die Dateien liegen in einem für die
# Gruppe beschreibbaren Ordner und gelten daher als NICHT vertrauenswürdig:
# erst atomar in einen root-eigenen Ordner verschieben, dann streng prüfen.
audit() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG_DIR/web-audit.log"; }

# ---------------------------------------------------------- Werkzeuge ---
TOOL_PKGS="clamav clamav-freshclam clamav-daemon rkhunter chkrootkit lynis openscap-scanner libopenscap8 unhide needrestart bind9-dnsutils testssl.sh aide aide-common python3-flask python3-waitress qrencode"

tools_state() { # tools_state true|false aktion [ok|failed]  – das Ergebnis zeigt die Seite „Werkzeuge“ an
  local f=$STATE_DIR/tools-update.state
  printf '{"running":%s,"action":"%s","time":%s,"result":"%s"}\n' "$1" "$2" "$(date +%s)" "${3:-}" >"$f.tmp"
  chgrp "$(grp)" "$f.tmp"; chmod 640 "$f.tmp"; mv -f "$f.tmp" "$f"
}

# ---------------------------------------------------------------- optionale Werkzeuge ---
# AIDE: Dateiintegrität für das ganze System (auch Konfigurationen und Programme außerhalb von Paketen).
# Große, sich ständig ändernde Datenordner werden ausgenommen, damit Datenbank und Prüfung überschaubar bleiben.
aide_excludes() {
  local d f=/etc/aide/aide.conf.d/99_ubusec_excludes
  [ -d /etc/aide/aide.conf.d ] || return 0
  {
    echo "# von ubusec – große oder sich ständig ändernde Datenordner nicht überwachen"
    for d in /var/lib/mysql /var/lib/postgresql /var/lib/docker /var/lib/containerd /var/lib/clamav /var/lib/ubusec \
             /var/log /var/cache /var/spool /var/tmp /tmp /swapfile /var/lib/php/sessions /var/webmin "$LOG_DIR"; do echo "!$d"; done
    echo '!/home/[^/]+/(Maildir|homes|tmp|logs|backup|backups)(/|$)'
    echo '!/home/[^/]+/domains/[^/]+/(logs|tmp)(/|$)'
    nextcloud_datadirs | sed 's/^/!/'
    backup_dirs | sed 's/^/!/'
  } >"$f.tmp"
  chmod 644 "$f.tmp"; mv -f "$f.tmp" "$f"
}
aide_aktiv() { [ -f "$STATE_DIR/aide-init.running" ] && kill -0 "$(cat "$STATE_DIR/aide-init.running" 2>/dev/null)" 2>/dev/null; }
aide_init_bg() { # Datenbank im Hintergrund anlegen (kann auf großen Servern lange dauern)
  # Fortschritt für die Weboberfläche: $STATE_DIR/aide-init.json (running → ok|failed), Protokoll: $LOG_DIR/aide-init.log
  if aide_aktiv; then echo "AIDE legt die Datenbank bereits an."; return 0; fi
  local j=$STATE_DIR/aide-init.json g; g=$(grp)
  local cmd="t0=\$(date +%s); printf '{\"state\":\"running\",\"started\":%s}' \$t0 >$j; chgrp $g $j; chmod 640 $j
    aideinit -y -f >$LOG_DIR/aide-init.log 2>&1; rc=\$?
    if [ -f /var/lib/aide/aide.db.new ]; then cp /var/lib/aide/aide.db.new /var/lib/aide/aide.db; st=ok; else st=failed; fi
    sz=\$(stat -c %s /var/lib/aide/aide.db 2>/dev/null || echo 0)
    printf '{\"state\":\"%s\",\"started\":%s,\"finished\":%s,\"rc\":%s,\"db_bytes\":%s}' \$st \$t0 \$(date +%s) \$rc \$sz >$j
    chgrp $g $j $LOG_DIR/aide-init.log; chmod 640 $j $LOG_DIR/aide-init.log
    rm -f $STATE_DIR/aide-init.running
    UBUSEC_FORCE_CHECK=1 $INSTALL_PATH --check-tools >/dev/null 2>&1"
  # Prozessnummer hier eintragen, nicht im Befehl selbst: systemd ersetzt „$$“ in der Befehlszeile durch „$“
  local pid=""
  if have systemd-run; then
    systemctl reset-failed ubusec-aide-init.service 2>/dev/null
    systemd-run --unit=ubusec-aide-init --quiet -p Nice=19 -p IOSchedulingClass=idle -p CPUWeight=20 \
      -p MemoryMax="$(scan_mem_limit_mb)M" /bin/bash -c "$cmd" && \
      pid=$(systemctl show -p MainPID --value ubusec-aide-init.service 2>/dev/null)
  else
    nohup /bin/bash -c "$cmd" >/dev/null 2>&1 &
    pid=$!
  fi
  if [[ $pid =~ ^[1-9][0-9]*$ ]]; then echo "$pid" >"$STATE_DIR/aide-init.running"; chmod 644 "$STATE_DIR/aide-init.running"; fi
  sleep 1; UBUSEC_FORCE_CHECK=1 check_tools >/dev/null   # Seite „Werkzeuge“ zeigt sofort „wird eingerichtet“
}
MALDET_URL=https://www.rfxn.com/downloads/maldetect-current.tar.gz   # laut rfxn.com/projects/linux-malware-detect
install_optional() { # install_optional aide|maldet
  local tool=$1 log=$STATE_DIR/tools-update.log rc=0 ok=0
  ensure_dirs; tools_state true "install-$tool"
  {
    echo "=== $tool installieren – $(date '+%d.%m.%Y %H:%M')"
    export DEBIAN_FRONTEND=noninteractive
    case $tool in
      aide)
        apt-get install -y -q aide aide-common || false
        if have aide; then
          aide_excludes
          echo "Ausnahmen: /etc/aide/aide.conf.d/99_ubusec_excludes"
          echo "AIDE-Datenbank wird im Hintergrund angelegt (Protokoll: $LOG_DIR/aide-init.log) – das kann je nach"
          echo "Datenmenge 10 bis 60 Minuten dauern. Danach prüft jeder Vollscan auf veränderte Dateien."
          aide_init_bg
          echo "=== fertig"; ok=1
        fi ;;
      maldet)
        local tmp; tmp=$(mktemp -d "$STATE_DIR/work/maldet.XXXXXX")
        local want="" have_md5=""
        want=$(curl -fsSL --max-time 30 "$MALDET_URL.md5" 2>/dev/null | grep -oiE '\b[0-9a-f]{32}\b' | head -1)
        if curl -fsSL --max-time 120 -o "$tmp/maldet.tgz" "$MALDET_URL" && have_md5=$(md5sum "$tmp/maldet.tgz" | cut -d' ' -f1) \
           && { [ -z "$want" ] && echo "Hinweis: Prüfsumme von rfxn.com nicht abrufbar – Download nur über HTTPS geprüft" \
                || { [ "${want,,}" = "$have_md5" ] && echo "Prüfsumme (MD5 laut rfxn.com) stimmt"; } \
                || { echo "Prüfsumme stimmt NICHT ($have_md5 statt $want) – Installation abgebrochen"; false; }; } \
           && tar -xzf "$tmp/maldet.tgz" -C "$tmp" \
           && d=$(dirname "$(find "$tmp" -maxdepth 2 -name install.sh | head -1)") && [ -f "$d/install.sh" ]; then
          echo "Heruntergeladen: $MALDET_URL ($(sha256sum "$tmp/maldet.tgz" | cut -c1-16)…)"
          (cd "$d" && ./install.sh) | tail -5
          local conf=/usr/local/maldetect/conf.maldet
          if [ -f "$conf" ]; then
            # ubusec ruft maldet selbst auf: kein eigener täglicher Scan, keine Mails, nichts automatisch in Quarantäne;
            # Signaturen und Programm aktualisiert maldet weiter selbst (mit Prüfsummen-Abgleich)
            local kv k
            for kv in cron_daily_scan=0 email_alert=0 quarantine_hits=0 scan_clamscan=auto autoupdate_signatures=1 \
                      autoupdate_version=1 autoupdate_version_hashed=1; do
              k=${kv%%=*}
              if grep -q "^$k=" "$conf"; then sed -i "s|^$k=.*|$k=\"${kv#*=}\"|" "$conf"; else echo "$k=\"${kv#*=}\"" >>"$conf"; fi
            done
            { nextcloud_datadirs; backup_dirs; } >>/usr/local/maldetect/ignore_paths 2>/dev/null
            sort -u -o /usr/local/maldetect/ignore_paths /usr/local/maldetect/ignore_paths 2>/dev/null
            maldet -u 2>&1 | tail -2
            echo "--- installiert: $(maldet 2>/dev/null | head -1)"
            echo "=== fertig"; ok=1
          else
            echo "Installation fehlgeschlagen"; false
          fi
        else
          echo "Download von $MALDET_URL fehlgeschlagen"; false
        fi
        rm -rf "$tmp" ;;
    esac
    [ $ok = 1 ]
  } >"$log" 2>&1 || rc=1
  [ $rc = 0 ] || echo "=== FEHLER – siehe oben" >>"$log"
  chgrp "$(grp)" "$log"; chmod 640 "$log"
  check_tools >/dev/null
  tools_state false "install-$tool" "$([ $rc = 0 ] && echo ok || echo failed)"
  return $rc
}

check_tools() { # nur die Werkzeuge prüfen, ohne Bericht
  ensure_dirs
  (
    RAW=$(mktemp -d "$STATE_DIR/work/tools.XXXXXX"); FINDINGS=$RAW/findings.tsv; : >"$FINDINGS"; MODE=quick
    mod_tools
    if [ -t 1 ]; then cut -f2,4 "$FINDINGS" | sed 's/\t/  /'; [ -s "$FINDINGS" ] || echo "Alle Werkzeuge sind aktuell."; fi
    rm -rf "$RAW"
  )
}

update_tools() { # Updates nur für ubusecs eigene Werkzeuge + frische Signaturen
  local log=$STATE_DIR/tools-update.log pkgs="" p f
  ensure_dirs; tools_state true update
  {
    echo "=== Werkzeuge aktualisieren – $(date '+%d.%m.%Y %H:%M')"
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -q
    for p in $TOOL_PKGS; do dpkg -s "$p" >/dev/null 2>&1 && pkgs+="$p "; done
    echo "--- Pakete: $pkgs"
    # shellcheck disable=SC2086
    apt-get install -y -q --only-upgrade -o Dpkg::Options::=--force-confold $pkgs
    echo "--- ClamAV-Signaturen"
    if systemctl is-active -q clamav-freshclam; then systemctl restart clamav-freshclam && sleep 25 && echo "Signaturdienst neu gestartet (lädt neue Signaturen)"
    else freshclam; fi
    echo "--- rkhunter-Daten"; rkhunter --update --nocolors || true
    echo "--- CVE-Daten werden beim nächsten Scan neu geladen"
    for f in "$STATE_DIR"/oval/*.xml; do [ -f "$f" ] && touch -d '2 days ago' "$f"; done
    echo "=== fertig – $(date '+%H:%M')"
  } >"$log" 2>&1
  chgrp "$(grp)" "$log"; chmod 640 "$log"
  check_tools >/dev/null
  tools_state false update "$(grep -q '^=== fertig' "$log" && echo ok || echo failed)"
}

CISOFY_KEY_URL=https://packages.cisofy.com/keys/cisofy-software-public.key
CISOFY_KEYRING=/etc/apt/keyrings/cisofy-software-public.gpg
CISOFY_LIST=/etc/apt/sources.list.d/cisofy-lynis.list
# Nur die CISOfy-Quelle aktualisieren; gibt eine fehlende Schlüssel-ID aus, Rückgabe 0 = Signatur geprüft
cisofy_apt_check() {
  local out
  out=$(apt-get update -q -o Dir::Etc::sourcelist="$CISOFY_LIST" -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 2>&1)
  echo "$out" >&2
  grep -oE 'NO_PUBKEY [0-9A-F]{16}' <<<"$out" | head -1 | cut -d' ' -f2
  ! grep -qE 'NO_PUBKEY|is not signed|EXPKEYSIG|BADSIG|KEYEXPIRED|Could not resolve|Failed to fetch' <<<"$out"
}
# Primärschlüssel-Fingerabdrücke einer Schlüsseldatei
key_primaries() { gpg --show-keys --with-colons "$1" 2>/dev/null | awk -F: '$1=="pub"{p=1;next} $1=="fpr"&&p{print $10;p=0}'; }
# Fehlt der Signaturschlüssel in der Datei des Herstellers, den Schlüssel vom Ubuntu-Keyserver holen –
# aber nur übernehmen, wenn er zum selben Hauptschlüssel gehört wie die Datei von cisofy.com
cisofy_key_from_keyserver() { # ID
  local id=$1 tmp prim new
  tmp=$(mktemp -d)
  echo "→ Signaturschlüssel $id fehlt in der Herstellerdatei – frage keyserver.ubuntu.com …"
  if ! curl -fsSL -m 30 "https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0x$id" -o "$tmp/ks.asc"; then
    echo "  Keyserver nicht erreichbar"; rm -rf "$tmp"; return 1
  fi
  prim=$(key_primaries "$CISOFY_KEYRING"); new=$(key_primaries "$tmp/ks.asc")
  echo "  Hauptschlüssel laut cisofy.com: ${prim:-?}"
  echo "  Hauptschlüssel laut Keyserver:  ${new:-?}"
  if [ -z "$new" ] || [ -z "$prim" ] || ! grep -qxF -f <(echo "$prim") <<<"$new"; then
    echo "  Abgelehnt: Der Schlüssel vom Keyserver gehört nicht zum Hauptschlüssel des Herstellers."
    rm -rf "$tmp"; return 1
  fi
  if ! gpg --show-keys --with-colons "$tmp/ks.asc" 2>/dev/null | awk -F: '$1=="fpr"{print $10}' | grep -q "$id\$"; then
    echo "  Abgelehnt: Der Keyserver-Schlüssel enthält $id nicht."; rm -rf "$tmp"; return 1
  fi
  gpg --dearmor --yes -o "$CISOFY_KEYRING" <"$tmp/ks.asc" && chmod 644 "$CISOFY_KEYRING"
  echo "  Übernommen (gleicher Hauptschlüssel, enthält $id)"
  rm -rf "$tmp"
}
cisofy_rollback() {
  rm -f "$CISOFY_LIST" /etc/apt/preferences.d/lynis "$CISOFY_KEYRING"
  apt-get update -q >/dev/null 2>&1
  echo "→ Paketquelle wieder entfernt – damit bleiben „apt update“ und die automatischen Sicherheitsupdates fehlerfrei."
  echo "  Lynis bleibt in der Ubuntu-Version installiert."
}

lynis_upstream() { # aktuelle Lynis-Version aus der Paketquelle des Herstellers (CISOfy)
  local log=$STATE_DIR/tools-update.log rc=0
  ensure_dirs; tools_state true lynis
  {
    echo "=== Lynis-Paketquelle des Herstellers einrichten – $(date '+%d.%m.%Y %H:%M')"
    install -d -m 0755 /etc/apt/keyrings
    local tmpk; tmpk=$(mktemp)
    if ! curl -fsSL -m 30 "$CISOFY_KEY_URL" -o "$tmpk" || ! gpg --dearmor --yes -o "$CISOFY_KEYRING" <"$tmpk"; then
      echo "Schlüssel von $CISOFY_KEY_URL nicht ladbar"; rm -f "$tmpk"; false
    else
      rm -f "$tmpk"; chmod 644 "$CISOFY_KEYRING"
      echo "Schlüssel des Herstellers:"; gpg --show-keys --with-subkey-fingerprints "$CISOFY_KEYRING" 2>/dev/null | sed 's/^/  /'
      # Schlüssel gilt nur für diese Quelle (signed-by), nicht für alle Paketquellen
      echo "deb [arch=$(dpkg --print-architecture) signed-by=$CISOFY_KEYRING] https://packages.cisofy.com/community/lynis/deb/ stable main" >"$CISOFY_LIST"
      printf 'Package: lynis\nPin: origin packages.cisofy.com\nPin-Priority: 600\n' >/etc/apt/preferences.d/lynis
      # apt prüft Signaturen als Benutzer _apt – die Dateien müssen für alle lesbar sein (ubusec läuft mit umask 027)
      chmod 644 "$CISOFY_KEYRING" "$CISOFY_LIST" /etc/apt/preferences.d/lynis
      local miss ok=1
      miss=$(cisofy_apt_check) || ok=0
      if [ $ok = 0 ] && [ -n "$miss" ] && cisofy_key_from_keyserver "$miss"; then
        ok=1; miss=$(cisofy_apt_check) || ok=0
      fi
      if [ $ok = 0 ]; then
        echo "FEHLER: Die Paketquelle von CISOfy lässt sich nicht sicher prüfen${miss:+ (Signaturschlüssel $miss fehlt)}."
        cisofy_rollback; false
      else
        export DEBIAN_FRONTEND=noninteractive
        apt-get install -y -q lynis && echo "--- installiert: $(lynis show version 2>/dev/null)" && echo "=== fertig"
      fi
    fi
  } >"$log" 2>&1 || rc=1
  [ $rc = 0 ] || echo "=== FEHLER – siehe oben" >>"$log"
  chgrp "$(grp)" "$log"; chmod 640 "$log"
  check_tools >/dev/null
  tools_state false lynis "$([ $rc = 0 ] && echo ok || echo failed)"
  return $rc
}

self_update() { # ubusec von GitHub aktualisieren (nur auf ausdrücklichen Befehl)
  local yes=$1 tmp info tag name url sums
  have curl || die "curl fehlt"
  echo "→ Frage GitHub nach der neuesten Version von $UBUSEC_REPO …"
  info=$(curl -fsSL -m 30 -H "Accept: application/vnd.github+json" "https://api.github.com/repos/$UBUSEC_REPO/releases/latest" \
    | python3 -I -c 'import json, sys
r = json.load(sys.stdin)
a = {x["name"]: x["browser_download_url"] for x in r.get("assets", [])}
tar = [n for n in a if n.startswith("ubusec-") and n.endswith(".tar.gz")]
print(r.get("tag_name", "").lstrip("v"))
print(tar[0] if tar else "")
print(a.get(tar[0], "") if tar else "")
print(a.get("SHA256SUMS", ""))
print(r.get("html_url", ""))') || die "GitHub nicht erreichbar oder noch keine Version veröffentlicht."
  { read -r tag; read -r name; read -r url; read -r sums; } <<<"$info"
  [ -n "$tag" ] && [ -n "$url" ] && [ -n "$sums" ] || die "Die neueste Version auf GitHub enthält kein vollständiges Paket."
  if ! python3 -I -c 'import re,sys; v=lambda s: tuple(int(x) for x in re.findall(r"\d+", s)[:4]); sys.exit(0 if v(sys.argv[1]) > v(sys.argv[2]) else 1)' "$tag" "$UBUSEC_VERSION"; then
    echo "✔ ubusec $UBUSEC_VERSION ist aktuell (neueste Version: $tag)."; return 0
  fi
  echo "Neue Version: $tag (installiert: $UBUSEC_VERSION)"
  echo "Änderungen: $(tail -1 <<<"$info")"
  if [ "$yes" != 1 ]; then
    [ -t 0 ] || die "Ohne Rückfrage nur mit --yes."
    local ans; read -r -p "Jetzt aktualisieren? [j/N] " ans; [[ $ans =~ ^[jJyY] ]] || { echo "Abgebrochen."; return 0; }
  fi
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
  curl -fsSL -m 300 -o "$tmp/$name" "$url" && curl -fsSL -m 60 -o "$tmp/SHA256SUMS" "$sums" || die "Download fehlgeschlagen."
  ( cd "$tmp" && grep -E "  $name\$" SHA256SUMS | sha256sum -c --quiet - ) || die "Prüfsumme stimmt nicht – Update abgebrochen."
  install -d -m 0700 "$tmp/x"; tar xzf "$tmp/$name" -C "$tmp/x"
  [ -f "$tmp/x/ubusec/ubusec" ] || die "Paket unvollständig."
  local args=(--install); [ -f "$WEB_DIR/ubusec_web.py" ] && args+=(--with-web)
  bash "$tmp/x/ubusec/ubusec" "${args[@]}" </dev/null
  echo "✔ Aktualisiert auf $tag."
}

