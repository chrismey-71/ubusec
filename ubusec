#!/usr/bin/env bash
# =============================================================================
#  ubusec – Sicherheits-Scanner für Ubuntu-Server
#
#  Bündelt bewährte Open-Source-Werkzeuge zu einem knappen Gesamtbericht:
#    OpenSCAP + Ubuntu-OVAL (CVEs) · Lynis (Härtung) · rkhunter · chkrootkit
#    unhide · ClamAV · Linux Malware Detect (optional) · AIDE (optional)
#    dpkg --verify · needrestart
#  plus eigene Prüfungen (Rechte, Firewall, Ports, SSH, sysctl, Baseline-
#  Vergleich, Malware-Heuristiken, Webshell-Suche).
#
#  Aufruf:  sudo ubusec --help
#  Lizenz:  MIT
# =============================================================================
set -uo pipefail
umask 027
export LC_ALL=C
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

UBUSEC_VERSION="1.5.14"
SELF_PATH=$(readlink -f "$0")
INSTALL_PATH=/usr/local/sbin/ubusec
CONF_DIR=/etc/ubusec
CONF_FILE=$CONF_DIR/ubusec.conf
IGNORE_FILE=$CONF_DIR/ignore.list
STATE_DIR=/var/lib/ubusec
BASE_DIR=$STATE_DIR/baseline
LOG_DIR=/var/log/ubusec
QUEUE_DIR=$STATE_DIR/queue
WEB_DIR=/usr/local/lib/ubusec/web
WEB_GROUP=ubusec
SRC_DIR=$(dirname "$SELF_PATH")

# ---------------------------------------------------------------- Defaults ---
# (werden von /etc/ubusec/ubusec.conf überschrieben)
CLAM_PATHS_QUICK="/tmp /var/tmp /dev/shm /root /home /var/www /etc /usr/local /opt"
CLAM_PATHS_FULL="/"
CLAM_EXCLUDE_DIRS="^/proc/ ^/sys/ ^/dev/ ^/run/ ^/snap/ ^/var/lib/docker/ ^/var/lib/clamav/ ^/var/log/ubusec/ ^/var/lib/ubusec/"
CLAM_MAX_FILESIZE="100M"
WEB_PATHS="/var/www /home"
RISKY_PORTS_HIGH="21 23 111 135 139 445 2375 2376 3306 5432 5984 6379 8086 9200 9300 11211 27017"
RISKY_PORTS_MED="10000 20000 8080 8443 5900"
MAIL_TO=""
NTFY_URL=""
NOTIFY_MIN="HOCH"
NOTIFY_ONLY_NEW=1
KEEP_DAYS=60
SITES_EXCLUDE=""
SITES_EXTRA=""
SITES_TESTSSL=0
WPSCAN_API_TOKEN=""
UBUSEC_REPO="chrismey-71/ubusec"   # GitHub-Repository für den Versionshinweis
UPDATE_CHECK=1               # bei GitHub nach neuen ubusec-Versionen fragen
CLAM_PARALLEL=0              # 0 = automatisch, sonst Anzahl paralleler Prüfungen
LYNIS_TIMEOUT=45m            # Höchstdauer des Lynis-Audits
CLAM_QUICK_CHANGED=1         # Schnellscan: nur seit dem letzten vollständigen Virenscan geänderte Dateien
CLAM_ENGINE=auto             # auto = laufenden ClamAV-Dienst (clamd) mitbenutzen; clamscan = immer eigene Prozesse
CLAM_EXCLUDE_DB=1            # Datenbankdateien (MySQL/MariaDB, PostgreSQL …)
CLAM_EXCLUDE_BACKUPS=1       # Backup-Ordner (/backup, ~/backups …)
CLAM_EXCLUDE_LOGS=1          # Protokolle (/var/log, ~/logs)
CLAM_EXCLUDE_MAIL=0          # Postfächer (Maildir)
CLAM_EXCLUDE_NEXTCLOUD=0     # Nextcloud-Datenordner (sinnvoll mit der App „Antivirus for files“)
CLAM_EXCLUDE_CUSTOM=""       # weitere Ordner, mit Leerzeichen getrennt
QUICK_ON=1; QUICK_DAYS="Mon,Tue,Wed,Thu,Fri,Sat"; QUICK_TIME="03:17"
FULL_ON=1;  FULL_DAYS="Sun";                     FULL_TIME="03:17"

SETTINGS_FILE=$CONF_DIR/settings.conf     # von der Weboberfläche verwaltet (sicher erzeugt)
SCHEDULE_FILE=$CONF_DIR/schedule.conf
CHECK_DIR=/usr/local/lib/ubusec/checks
[ -r "$CONF_FILE" ] && . "$CONF_FILE"
[ -r "$SETTINGS_FILE" ] && . "$SETTINGS_FILE"
[ -r "$SCHEDULE_FILE" ] && . "$SCHEDULE_FILE"

# ------------------------------------------------------------- Konstanten ---
declare -A RANK=([KRITISCH]=4 [HOCH]=3 [MITTEL]=2 [NIEDRIG]=1 [INFO]=0)
ALL_MODULES="tools updates cve config perms firewall integrity baseline rootkit malware web sites apps"
QUICK_MODULES="tools updates cve firewall integrity baseline rootkit malware"
declare -A MOD_TITLE=(
  [tools]="Prüfwerkzeuge"           [updates]="Updates & Neustarts"   [cve]="CVE-Schwachstellen"
  [config]="Konfiguration & Härtung" [perms]="Dateiberechtigungen"
  [firewall]="Firewall & Ports"     [integrity]="Datei-Integrität"
  [baseline]="Änderungen ggü. Baseline" [rootkit]="Rootkits & Einbruchsspuren"
  [malware]="Malware (ClamAV)"      [web]="Webshells & Web-Malware"
  [sites]="Websites & Domains"      [apps]="Webanwendungen"
)

# ----------------------------------------------------------- Hilfsfunktionen ---
COLOR=0; QUIET=0; MODE=quick; NOTIFY=1; TRIGGER=manual
die()  { echo "ubusec: $*" >&2; exit 64; }
have() { command -v "$1" >/dev/null 2>&1; }
log()  { [ "$QUIET" = 1 ] || printf '%s\n' "$*" >&2; }

c() { # c FARBE TEXT
  if [ "$COLOR" = 1 ]; then
    case $1 in
      KRITISCH) printf '\e[1;37;41m%s\e[0m' "$2" ;; HOCH) printf '\e[1;31m%s\e[0m' "$2" ;;
      MITTEL) printf '\e[1;33m%s\e[0m' "$2" ;;     NIEDRIG) printf '\e[36m%s\e[0m' "$2" ;;
      INFO|dim) printf '\e[2m%s\e[0m' "$2" ;;      ok) printf '\e[32m%s\e[0m' "$2" ;;
      bold) printf '\e[1m%s\e[0m' "$2" ;;          *) printf '%s' "$2" ;;
    esac
  else printf '%s' "$2"; fi
}

IGNORES=()
load_ignores() {
  [ -r "$IGNORE_FILE" ] || return 0
  local l
  while IFS= read -r l; do
    [[ $l =~ ^[[:space:]]*(#|$) ]] && continue
    IGNORES+=("$l")
  done <"$IGNORE_FILE"
}

SUPPRESSED=0
# add SCHWERE MODUL MELDUNG [DETAIL ...]
# apt-get wartet bis zu 5 Minuten, wenn gerade ein anderes apt läuft (z. B. unattended-upgrades),
# statt sofort mit „Could not get lock /var/lib/dpkg/lock-frontend“ abzubrechen
apt-get() { command apt-get -o DPkg::Lock::Timeout=300 "$@"; }

add() {
  local sev=$1 mod=$2 msg=$3; shift 3
  local det="" i
  for i in "$@"; do i=${i//$'\t'/ }; i=${i//$'\n'/ }; det+="${det:+$'\x1f'}$i"; done
  msg=${msg//$'\t'/ }; msg=${msg//$'\n'/ }
  for i in "${IGNORES[@]}"; do
    if [[ "$mod|$msg|$det" =~ $i ]]; then SUPPRESSED=$((SUPPRESSED+1)); return 0; fi
  done
  printf '%s\t%s\t%s\t%s\t%s\n' "${RANK[$sev]}" "$sev" "$mod" "$msg" "$det" >>"$FINDINGS"
}

# take DATEI MAX  -> füllt ITEMS mit höchstens MAX Zeilen (+ Hinweis auf Rest)
ITEMS=()
take() {
  local f=$1 max=${2:-10} n
  ITEMS=()
  [ -s "$f" ] || return 0
  n=$(wc -l <"$f")
  mapfile -t ITEMS < <(head -n "$max" "$f")
  if (( n > max )); then ITEMS+=("… und $((n-max)) weitere → $f"); fi
}

need() { # need BEFEHL MODUL PAKET
  have "$1" && return 0
  add NIEDRIG "$2" "$1 nicht installiert – Teilprüfung übersprungen" "Installieren: apt install $3  (oder: ubusec --install)"
  return 1
}

# Liste öffentlich lauschender Dienste: "proto port prozess"
public_ports() {
  ss -H -tulpn 2>/dev/null | awk '
    { proto=$1; loc=$5; proc=$7
      n=split(loc,a,":"); port=a[n]; addr=substr(loc,1,length(loc)-length(port)-1)
      gsub(/[\[\]]/,"",addr); sub(/%.*/,"",addr)
      if (addr ~ /^127\./ || addr=="::1" || addr ~ /^::ffff:127\./) next
      p="?"; if (match(proc,/\("[^"]+"/)) p=substr(proc,RSTART+2,RLENGTH-3)
      print proto, port, p }' | sort -u -k1,1 -k2,2n
}

local_mounts() {
  df -l -P -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs -x fuse.lxcfs 2>/dev/null \
    | awk 'NR>1{print $6}' | sort -u
}

# Abbruch (systemctl stop, Strg+C, „Scan abbrechen“ in der Weboberfläche)
on_abort() { # on_abort SIGNAL
  trap - INT TERM HUP EXIT
  pkill -TERM -P $$ 2>/dev/null          # laufendes Werkzeug (z. B. clamscan) mit beenden
  local el=$(( $(date +%s) - ${T0:-0} )) limit=50400
  [ "$TRIGGER" = timer ] && [ "$MODE" = quick ] && limit=21600
  if [ -f "$STATE_DIR/cancel-requested" ]; then
    ABORT_REASON="Abbruch durch Benutzer in der Weboberfläche"; rm -f "$STATE_DIR/cancel-requested"
  elif [ "${1:-}" = INT ]; then ABORT_REASON="Abbruch auf der Kommandozeile (Strg+C)"
  elif [ "${1:-}" = HUP ]; then ABORT_REASON="Sitzung beendet (Terminal geschlossen)"
  elif systemctl is-system-running 2>/dev/null | grep -q stopping; then ABORT_REASON="Server wurde heruntergefahren oder neu gestartet"
  elif (( el >= limit - 120 )); then ABORT_REASON="Zeitlimit überschritten ($(( limit / 3600 )) Stunden)"
  else ABORT_REASON="Von außen beendet (z. B. systemctl stop)"; fi
  [ "$CUR_MOD" = malware ] && [ -n "${RAW:-}" ] && SUB_DONE=$(clam_count)
  write_status false "$CUR_MOD" "$MOD_I" "$MOD_N" 130 ""
  [ -n "${LOG_DIR:-}" ] && printf '%s Scan abgebrochen (%s, PID %s): %s\n' "$(date '+%F %T')" "${MODE_LABEL:-$MODE}" "$$" "$ABORT_REASON" >>"$LOG_DIR/web-audit.log"
  log "ubusec: Scan abgebrochen – $ABORT_REASON"
  exit 130
}

grp() { getent group "$WEB_GROUP" >/dev/null 2>&1 && echo "$WEB_GROUP" || echo root; }

ensure_dirs() {
  local g; g=$(grp)
  install -d -m 0750 -o root -g "$g" "$STATE_DIR" "$LOG_DIR" "$LOG_DIR/raw"
  install -d -m 0700 -o root -g root "$BASE_DIR" "$STATE_DIR/work"
  install -d -m 0770 -o root -g "$g" "$QUEUE_DIR"
  install -d -m 0755 -o root -g root "$CONF_DIR"
  install -d -m 0700 -o root -g root "$STATE_DIR/cache"
  if id "$WEB_GROUP" >/dev/null 2>&1; then
    install -d -m 0700 -o "$WEB_GROUP" -g "$WEB_GROUP" "$STATE_DIR/web"
    [ -f "$IGNORE_FILE" ] && { chown root:"$g" "$IGNORE_FILE"; chmod 640 "$IGNORE_FILE"; }
    [ -f "$LOG_DIR/web-audit.log" ] && { chown root:"$g" "$LOG_DIR/web-audit.log"; chmod 640 "$LOG_DIR/web-audit.log"; }
  fi
}

# Statusdatei für die Weboberfläche (atomar geschrieben)
SUB_DONE=0; SUB_TOTAL=0; SUB_TEXT=""; SUB_START=0; ABORT_REASON=""; CUR_MOD=""; MOD_I=0; MOD_N=0
write_status() { # write_status running modul index total [exitcode report]
  local f=$STATE_DIR/status.json t="" st
  [ -n "$2" ] && t=${MOD_TITLE[$2]:-}
  st=${SUB_TEXT//[\\\"]/_}; st=${st//[$'\t\n\r']/ }
  printf '{"running":%s,"mode":"%s","label":"%s","module":"%s","module_title":"%s","index":%s,"total":%s,"started":%s,"updated":%s,"trigger":"%s","exit":%s,"report":"%s","pid":%s,"sub_done":%s,"sub_total":%s,"sub_text":"%s","sub_start":%s,"abort_reason":"%s"}\n' \
    "$1" "$MODE" "${MODE_LABEL:-}" "$2" "$t" "$3" "$4" "${T0:-0}" "$(date +%s)" "$TRIGGER" "${5:-null}" "${6:-}" "$$" \
    "${SUB_DONE:-0}" "${SUB_TOTAL:-0}" "$st" "${SUB_START:-0}" "${ABORT_REASON//\"/\'}" >"$f.tmp"
  chgrp "$(grp)" "$f.tmp" 2>/dev/null; chmod 640 "$f.tmp"; mv -f "$f.tmp" "$f"
}

# ============================================================================
#  MODUL: updates – ausstehende Updates, Neustarts, Support-Status
# ============================================================================
mod_updates() {
  apt-get update -qq >"$RAW/apt-update.log" 2>&1 \
    || add NIEDRIG updates "apt-get update fehlgeschlagen – Update-Daten evtl. veraltet" "Log: $RAW/apt-update.log"

  apt list --upgradable 2>/dev/null | grep -v '^Listing' >"$RAW/upgradable.txt"
  grep -- '-security' "$RAW/upgradable.txt" | cut -d/ -f1 >"$RAW/upg-security.txt"
  grep -v -- '-security' "$RAW/upgradable.txt" | cut -d/ -f1 >"$RAW/upg-other.txt"
  local ns no
  ns=$(grep -c . "$RAW/upg-security.txt"); no=$(grep -c . "$RAW/upg-other.txt")
  if (( ns > 0 )); then take "$RAW/upg-security.txt" 12
    add HOCH updates "$ns Sicherheitsupdates ausstehend" "${ITEMS[@]}" "Beheben: apt upgrade"
  fi
  (( no > 0 )) && add NIEDRIG updates "$no weitere Paket-Updates verfügbar" "Liste: $RAW/upg-other.txt"

  local held; held=$(apt-mark showhold 2>/dev/null | tr '\n' ' ')
  [ -n "$held" ] && add NIEDRIG updates "Zurückgehaltene Pakete (hold): $held"

  if [ -f /var/run/reboot-required ]; then
    add MITTEL updates "Neustart erforderlich (Updates erst nach Reboot wirksam)" \
      "Auslöser: $(tr '\n' ' ' </var/run/reboot-required.pkgs 2>/dev/null)"
  fi

  if have needrestart; then
    needrestart -b -r l >"$RAW/needrestart.txt" 2>/dev/null
    local ksta kcur kexp svc
    ksta=$(awk -F': ' '/NEEDRESTART-KSTA/{print $2}' "$RAW/needrestart.txt")
    kcur=$(awk -F': ' '/NEEDRESTART-KCUR/{print $2}' "$RAW/needrestart.txt")
    kexp=$(awk -F': ' '/NEEDRESTART-KEXP/{print $2}' "$RAW/needrestart.txt")
    [ "${ksta:-0}" -gt 1 ] 2>/dev/null && \
      add MITTEL updates "Laufender Kernel ist veraltet (läuft: $kcur, installiert: $kexp)" "Beheben: Neustart"
    awk -F': ' '/NEEDRESTART-SVC/{print $2}' "$RAW/needrestart.txt" >"$RAW/needrestart-svc.txt"
    svc=$(grep -c . "$RAW/needrestart-svc.txt")
    if (( svc > 0 )); then take "$RAW/needrestart-svc.txt" 8
      add MITTEL updates "$svc Dienste laufen noch mit alten (ggf. verwundbaren) Bibliotheken" "${ITEMS[@]}" "Beheben: needrestart -r a"
    fi
  else need needrestart updates needrestart; fi

  # Eingeschaltet wird über APT::Periodic::Unattended-Upgrade (meist in 20auto-upgrades) – erlaubt sind Zahlen
  # oder Zeitspannen wie "1", "1d", "always"; "0"/leer heißt aus. 50unattended-upgrades legt nur fest, WAS installiert wird.
  local uu_val uu_timer uu_det=()
  uu_val=$(apt-config dump 2>/dev/null | sed -n 's/^APT::Periodic::Unattended-Upgrade "\(.*\)";$/\1/p' | tail -1)
  uu_timer=$(systemctl is-enabled apt-daily-upgrade.timer 2>/dev/null)
  if ! dpkg -s unattended-upgrades 2>/dev/null | grep -q '^Status: install ok installed'; then
    uu_det+=("Paket unattended-upgrades ist nicht installiert")
  fi
  if [ -z "$uu_val" ] || [[ $uu_val =~ ^(0+|never|false|no)$ ]]; then
    local uu_show="nicht gesetzt"; [ -n "$uu_val" ] && uu_show="auf „$uu_val“ (aus)"
    uu_det+=("APT::Periodic::Unattended-Upgrade ist $uu_show – eingeschaltet wird es in /etc/apt/apt.conf.d/20auto-upgrades, nicht in 50unattended-upgrades")
  fi
  if [ -n "$uu_timer" ] && [[ ! $uu_timer =~ ^(enabled|static|alias)$ ]]; then
    uu_det+=("Der systemd-Timer apt-daily-upgrade.timer ist „$uu_timer“ – ohne ihn laufen keine automatischen Updates")
  fi
  if (( ${#uu_det[@]} > 0 )); then
    add MITTEL updates "Automatische Sicherheitsupdates (unattended-upgrades) nicht aktiv" "${uu_det[@]}" \
      "Beheben: sudo apt install unattended-upgrades && sudo dpkg-reconfigure -plow unattended-upgrades (Frage mit „Ja“ beantworten)"
  fi

  if have ubuntu-distro-info; then
    if ! ubuntu-distro-info --supported 2>/dev/null | grep -qx "$OS_CODENAME"; then
      if ubuntu-distro-info --supported-esm 2>/dev/null | grep -qx "$OS_CODENAME"; then
        add HOCH updates "Ubuntu $OS_VERSION ist aus dem Standard-Support – nur noch mit Ubuntu Pro (ESM) Updates"
      else
        add KRITISCH updates "Ubuntu $OS_VERSION erhält keine Sicherheitsupdates mehr (End of Life)"
      fi
    fi
  fi
}

# ============================================================================
#  MODUL: cve – bekannte Schwachstellen installierter Pakete (Ubuntu OVAL)
# ============================================================================
mod_cve() {
  need oscap cve "openscap-scanner (bzw. libopenscap8)" || return 0
  need bunzip2 cve bzip2 || return 0
  local dir=$STATE_DIR/oval oval url
  mkdir -p "$dir"
  oval=$dir/com.ubuntu.$OS_CODENAME.usn.oval.xml
  url="https://security-metadata.canonical.com/oval/com.ubuntu.$OS_CODENAME.usn.oval.xml.bz2"
  if [ ! -s "$oval" ] || [ -n "$(find "$oval" -mmin +600 2>/dev/null)" ]; then
    if curl -fsSL --max-time 300 -o "$oval.bz2" "$url" 2>"$RAW/oval-download.log" \
       && bunzip2 -c "$oval.bz2" >"$oval.tmp"; then mv "$oval.tmp" "$oval"
    else add NIEDRIG cve "Ubuntu-OVAL-Daten konnten nicht geladen werden" "$url"; fi
    rm -f "$oval.bz2" "$oval.tmp"
  fi
  [ -s "$oval" ] || return 0

  oscap oval eval --results "$RAW/oval-results.xml" --report "$RAW/oval-report.html" "$oval" \
    >"$RAW/oscap.log" 2>&1
  [ -s "$RAW/oval-results.xml" ] || { add NIEDRIG cve "OpenSCAP-Auswertung fehlgeschlagen" "Log: $RAW/oscap.log"; return 0; }

  python3 - "$RAW/oval-results.xml" >"$RAW/cve-hits.tsv" <<'PY'
import sys, xml.etree.ElementTree as ET
root = ET.parse(sys.argv[1]).getroot()
ln = lambda e: e.tag.rsplit('}', 1)[-1]
defs, hits = {}, set()
for d in root.iter():
    if ln(d) != 'definition':
        continue
    if d.get('result') == 'true' and d.get('definition_id'):
        hits.add(d.get('definition_id'))
    elif d.get('id') and d.get('class') == 'inventory':
        defs[d.get('id')] = None   # „Check that Ubuntu … is installed“ – keine Sicherheitsmeldung
    elif d.get('id') and d.get('class'):
        title, sev, cves = '', '', 0
        for x in d.iter():
            n = ln(x)
            if n == 'title' and not title: title = (x.text or '').strip()
            elif n == 'severity' and not sev: sev = (x.text or '').strip()
            elif n == 'cve': cves += 1
        defs[d.get('id')] = (title, sev, cves)
for h in sorted(hits):
    if h in defs and defs[h] is None:
        continue
    t, s, n = defs.get(h) or (h, '', 0)
    print(f"{s or 'Unknown'}\t{n}\t{t}")
PY
  local total; total=$(grep -c . "$RAW/cve-hits.tsv")
  if (( total == 0 )); then
    add INFO cve "Keine offenen CVEs mit verfügbarem Fix gefunden (Ubuntu OVAL, $(date -r "$oval" +%d.%m.%Y))"
    return 0
  fi
  local s sev n cves
  for s in Critical High Medium Low Negligible Unknown; do
    awk -F'\t' -v s="$s" '$1==s{print $3"  ("$2" CVEs)"}' "$RAW/cve-hits.tsv" >"$RAW/cve-$s.txt"
    n=$(grep -c . "$RAW/cve-$s.txt"); (( n == 0 )) && continue
    cves=$(awk -F'\t' -v s="$s" '$1==s{t+=$2}END{print t+0}' "$RAW/cve-hits.tsv")
    case $s in Critical) sev=KRITISCH;; High) sev=HOCH;; Medium) sev=MITTEL;; *) sev=NIEDRIG;; esac
    take "$RAW/cve-$s.txt" 8
    add "$sev" cve "$n Sicherheitsmeldungen (USN) der Stufe $s offen – $cves CVEs" "${ITEMS[@]}"
  done
  # Welche Pakete bekommen Sicherheitskorrekturen nur über Ubuntu Pro (ESM)? – und warum sind sie installiert?
  if have pro && ! pro status --format json 2>/dev/null | grep -q '"attached": *true'; then
    pro security-status --format json 2>/dev/null >"$RAW/pro-security-status.json"
    python3 -I - "$RAW/pro-security-status.json" >"$RAW/esm-packages.txt" 2>/dev/null <<'PY2'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
for p in d.get("packages", []):
    if p.get("service_name") in ("esm-apps", "esm-infra") and p.get("status") in ("pending_attach", "pending_enable"):
        print(p.get("package", ""), p.get("service_name", ""))
PY2
    if [ -s "$RAW/esm-packages.txt" ]; then
      local pkg svc why lines=() manual
      manual=$(apt-mark showmanual 2>/dev/null)
      while read -r pkg svc; do
        if grep -qx "$pkg" <<<"$manual"; then why="direkt installiert (von dir oder Virtualmin)"
        else why="benötigt von: $(apt-cache rdepends --installed --no-suggests --no-enhances "$pkg" 2>/dev/null | sed '1,2d; s/^ *|*//' | sort -u | head -3 | paste -sd, - | sed 's/,/, /g')"; fi
        lines+=("$pkg – $why")
      done < <(sort -u "$RAW/esm-packages.txt")
      local np=${#lines[@]}
      (( np > 12 )) && lines=("${lines[@]:0:12}" "… und $(( np - 12 )) weitere (Liste: $RAW/esm-packages.txt)")
      add MITTEL cve "$np Pakete erhalten Sicherheitskorrekturen nur mit Ubuntu Pro (ESM)" "${lines[@]}" \
        "Ohne Ubuntu Pro: Nicht benötigte Pakete entfernen (sudo apt purge <paket>; danach sudo apt autoremove)"
    fi
  fi
  add INFO cve "CVE-Detailbericht (HTML)" "$RAW/oval-report.html" \
    "Hinweis: Fixes aus 'esm-apps/esm-infra' benötigen Ubuntu Pro (kostenlos für bis zu 5 Rechner)"
}

# ============================================================================
#  MODUL: config – Lynis-Audit, SSH, sysctl, Konten, Schutzdienste
# ============================================================================
uid_dupes() { # Lynis AUTH-9208 genauer: Konten mit gleicher UID – bei Virtualmin meist Webzugänge einer Domain
  # Ein Zweitkonto gilt als Virtualmin-Webzugang, wenn sein Heimatordner im Ordner des Erstkontos liegt und es keine
  # echte Shell hat (/bin/false, nologin) – so legt Virtualmin FTP/SFTP-Zugänge zu den Webdateien an.
  local ok=() bad=() line
  while IFS= read -r line; do
    case $line in OK*) ok+=("${line#OK }") ;; BAD*) bad+=("${line#BAD }") ;; esac
  done < <(awk -F: '{ n[$3]++; u[$3]=u[$3] SUBSEP $1 "|" $6 "|" $7 }
    END { for (id in n) if (n[id] > 1) {
      k = split(substr(u[id], 2), a, SUBSEP); split(a[1], p, "|"); good = 1; names = p[1]
      for (i = 2; i <= k; i++) { split(a[i], q, "|"); names = names ", " q[1]
        if (!(index(q[2] "/", p[2] "/") == 1 && q[3] ~ /(false|nologin|\/dev\/null)$/)) good = 0 }
      if (id == 0) good = 0
      printf "%s UID %s: %s\n", (good ? "OK" : "BAD"), id, names } }' /etc/passwd 2>/dev/null)
  if [ ${#bad[@]} -gt 0 ]; then
    add MITTEL config "Mehrere Benutzerkonten mit derselben UID (Lynis AUTH-9208)" "${bad[@]}" \
      "Prüfen: awk -F: '\$3==UID {print \$1, \$6, \$7}' /etc/passwd  (UID einsetzen)"
  fi
  if [ ${#ok[@]} -gt 0 ]; then
    add INFO config "Konten mit gleicher UID sind Virtualmin-Webzugänge (in Ordnung)" "${ok[@]}"
  fi
}

mod_config() {
  # --- Lynis ---------------------------------------------------------------
  if need lynis config lynis; then
    # Eigenes Lynis-Profil: CRYP-7902 sucht Zertifikatsdateien mit find -L und folgt dabei symbolischen Links –
    # auf Virtualmin-Servern bis in große Web- und Datenordner (dauert dann Stunden). Die Zertifikate der
    # Domains prüft ubusec im Bereich „Websites & Domains“ selbst.
    # Eintrag in custom.prf (von Lynis zusätzlich zu default.prf gelesen; gilt auch für eigene Lynis-Aufrufe)
    local pdir
    for pdir in /etc/lynis /usr/local/etc/lynis ""; do [ -f "$pdir/default.prf" ] && break; done
    if [ -n "$pdir" ] && ! grep -qix 'skip-test=CRYP-7902' "$pdir/custom.prf" 2>/dev/null; then
      printf '\n# von ubusec ergänzt: Zertifikatssuche folgt Links bis in große Datenordner; Zertifikate prüft ubusec selbst\nskip-test=CRYP-7902\n' \
        >>"$pdir/custom.prf"
      chmod 644 "$pdir/custom.prf"
    fi
    timeout --kill-after=60 "${LYNIS_TIMEOUT:-45m}" lynis audit system --cronjob --no-colors --quiet \
      --report-file "$RAW/lynis-report.dat" --logfile "$RAW/lynis.log" >"$RAW/lynis.out" 2>&1 &
    local lpid=$! ltest lrc=0
    # Fortschritt für die Weboberfläche: aktuellen Lynis-Test aus dem Protokoll zeigen
    SUB_START=$(date +%s)
    while kill -0 "$lpid" 2>/dev/null; do
      ltest=$(grep -a 'Performing test ID' "$RAW/lynis.log" 2>/dev/null | tail -n1 | sed -E 's/.*Performing test ID ([A-Z0-9-]+) \((.*)\).*/Lynis-Test \1: \2/')
      if [ -n "$ltest" ] && [ "$ltest" != "$SUB_TEXT" ]; then SUB_TEXT=$ltest; write_status true "$CUR_MOD" "$MOD_I" "$MOD_N"; fi
      sleep 5
    done
    wait "$lpid" 2>/dev/null || lrc=$?
    SUB_TEXT=""
    if (( lrc == 124 || lrc == 137 )); then
      add MITTEL config "Lynis-Audit nach ${LYNIS_TIMEOUT:-45m} abgebrochen – Ergebnis unvollständig" \
        "Hängen geblieben bei: ${ltest:-unbekannt}" "Protokoll: $RAW/lynis.log" \
        "Einzelne Tests lassen sich in /etc/lynis/custom.prf mit skip-test=TEST-ID überspringen"
    fi
    # auch an den Standardort legen, damit „lynis show details TEST-ID“ funktioniert
    [ -s "$RAW/lynis.log" ] && install -m 0640 "$RAW/lynis.log" /var/log/lynis.log
    [ -s "$RAW/lynis-report.dat" ] && install -m 0640 "$RAW/lynis-report.dat" /var/log/lynis-report.dat
    local hi line id txt
    hi=$(awk -F= '/^hardening_index=/{print $2; exit}' "$RAW/lynis-report.dat" 2>/dev/null)
    while IFS= read -r line; do
      id=${line%%|*}; txt=${line#*|}; txt=${txt%%|*}
      if [ "$id" = AUTH-9208 ]; then uid_dupes; continue; fi
      add MITTEL config "Lynis-Warnung: $txt [$id]" "Details: sudo lynis show details $id"
    done < <(sed -n 's/^warning\[\]=//p' "$RAW/lynis-report.dat" 2>/dev/null)
    # Vorschläge: mit Detail (z. B. welche SSH-Option), ohne Doppelte, ohne Tests, die schon als Warnung erscheinen;
    # auf virtuellen Servern ohne Vorschläge, die dort nicht umsetzbar sind (GRUB-Passwort, Partitionen, USB)
    local virt=0; systemd-detect-virt -q 2>/dev/null && virt=1
    sed -n 's/^warning\[\]=//p' "$RAW/lynis-report.dat" 2>/dev/null | cut -d'|' -f1 | sort -u >"$RAW/lynis-warn-ids.txt"
    sed -n 's/^suggestion\[\]=//p' "$RAW/lynis-report.dat" 2>/dev/null \
      | awk -F'|' -v virt=$virt 'BEGIN { while ((getline w < ARGV[2]) > 0) warn[w] = 1; ARGV[2] = "" }
          { id = $1; sub(/:.*/, "", id)
            if (id in warn) next
            if (virt && id ~ /^(BOOT-5122|FILE-6310|USB-1000|USB-2000|USB-3000|STRG-1846|PROC-3614)$/) { hid++; next }
            t = $2; d = $3
            # diese SSH-Optionen prüft ubusec selbst (eigene Befunde mit Anleitung)
            if (id == "SSH-7408" && d ~ /^(PermitRootLogin|PasswordAuthentication|X11Forwarding|MaxAuthTries|KbdInteractiveAuthentication|PermitEmptyPasswords)/) next
            # Vorschläge ohne Zielwert („Port (set 22 to )“) sind nicht umsetzbar; debsums ersetzt ubusec durch die
            # eigene Paketprüfung (dpkg --verify plus Vergleich mit dem Originalpaket)
            if (d ~ /to \)$/ || id == "PKGS-7370") next
            if (d != "" && d != "-" && index(t, d) == 0) t = t ": " d
            line = t " [" $1 "]"
            if (!(line in seen)) { seen[line] = 1; print line } }
          END { if (hid) print hid > "/dev/stderr" }' - "$RAW/lynis-warn-ids.txt" \
      >"$RAW/lynis-suggestions.txt" 2>"$RAW/lynis-hidden-count.txt"
    if [ -n "$hi" ]; then
      take "$RAW/lynis-suggestions.txt" 6
      if (( hi < 65 )); then
        add MITTEL config "Lynis-Härtungsindex nur $hi/100 – $(grep -c . "$RAW/lynis-suggestions.txt") Vorschläge" "${ITEMS[@]}"
      else
        add INFO config "Lynis-Härtungsindex $hi/100 – $(grep -c . "$RAW/lynis-suggestions.txt") Vorschläge" "${ITEMS[@]}"
      fi
    fi
  fi

  # --- SSH -----------------------------------------------------------------
  if have sshd && sshd -T >"$RAW/sshd-T.txt" 2>/dev/null; then
    sv() { awk -v k="$1" '$1==k{print $2; exit}' "$RAW/sshd-T.txt"; }
    case $(sv permitrootlogin) in
      yes) add HOCH config "SSH: Root-Login mit Passwort erlaubt (PermitRootLogin yes)" "Empfehlung: PermitRootLogin prohibit-password oder no" \
             "Schritt-für-Schritt-Anleitung und Schlüsselverwaltung: Weboberfläche → Einstellungen → SSH-Schlüssel (oder ubusec --ssh-help)";;
    esac
    ssh_keys_status status   # Schlüssel und letzte Anmeldungen für die Seite „SSH-Schlüssel“ auffrischen
    if [ "$(sv passwordauthentication)" = yes ]; then
      # Wer kann sich überhaupt mit Passwort anmelden? (Passwort gesetzt und eine echte Login-Shell; SFTP geht bei
      # Virtualmin-Benutzern auch mit /bin/sh, bei /usr/sbin/nologin nicht)
      local pwu="" pwn=0 prl; prl=$(sv permitrootlogin)
      pwu=$(awk -F: 'NR==FNR { if ($2 != "" && $2 !~ /^[!*]/) pw[$1]=1; next }
                     ($1 in pw) && $1 != "root" && $7 !~ /(nologin|false|sync|shutdown|halt|\/dev\/null)$/ && $7 != "" { print $1 }' \
                 /etc/shadow /etc/passwd 2>/dev/null | sort | head -40 | paste -sd, - | sed 's/,/, /g')
      [ -n "$pwu" ] && pwn=$(tr ',' '\n' <<<"$pwu" | grep -c .)
      if [ "$prl" != yes ]; then
        if [ "$pwn" -gt 0 ]; then
          add NIEDRIG config "SSH: Passwort-Anmeldung für andere Benutzer aktiv (root nur mit Schlüssel)" \
            "root meldet sich nur noch mit Schlüssel an (PermitRootLogin $prl) – gut." \
            "Mit Passwort per SSH/SFTP anmelden können sich noch $pwn Benutzer: $pwu" \
            "Bei Virtualmin oft gewollt (SFTP für Domain-Benutzer); fail2ban bremst Rateversuche."
        fi
      else
        add MITTEL config "SSH: Passwort-Anmeldung aktiv – anfällig für Brute-Force" "Empfehlung: nur Schlüssel (PasswordAuthentication no)" \
          ${pwu:+"Benutzer mit Passwort und Login-Shell (außer root): $pwu"}
      fi
    fi
    [ "$(sv permitemptypasswords)" = yes ] && add KRITISCH config "SSH: Leere Passwörter erlaubt (PermitEmptyPasswords yes)"
    [ "$(sv x11forwarding)" = yes ] && add NIEDRIG config "SSH: X11Forwarding aktiv (auf Servern unnötig)"
    local mat; mat=$(sv maxauthtries)
    [ -n "$mat" ] && (( mat > 4 )) && add NIEDRIG config "SSH: MaxAuthTries $mat (empfohlen: ≤ 4)"
  fi

  # --- sysctl --------------------------------------------------------------
  local spec key want sev cur
  : >"$RAW/sysctl-dev.txt"
  for spec in \
    "kernel.randomize_va_space:^2$:MITTEL" "fs.protected_hardlinks:^1$:MITTEL" \
    "fs.protected_symlinks:^1$:MITTEL"     "fs.suid_dumpable:^0$:NIEDRIG" \
    "kernel.kptr_restrict:^[12]$:NIEDRIG"  "kernel.dmesg_restrict:^1$:NIEDRIG" \
    "kernel.yama.ptrace_scope:^[123]$:NIEDRIG" "net.ipv4.tcp_syncookies:^1$:NIEDRIG" \
    "net.ipv4.conf.all.accept_redirects:^0$:NIEDRIG" "net.ipv4.conf.all.send_redirects:^0$:NIEDRIG" \
    "net.ipv4.conf.all.accept_source_route:^0$:NIEDRIG" "net.ipv4.conf.all.log_martians:^1$:NIEDRIG" \
    "net.ipv6.conf.all.accept_redirects:^0$:NIEDRIG"; do
    IFS=: read -r key want sev <<<"$spec"
    cur=$(sysctl -n "$key" 2>/dev/null) || continue
    [[ $cur =~ $want ]] || echo "$sev $key = $cur (empfohlen ${want//[\^\$]/})" >>"$RAW/sysctl-dev.txt"
  done
  for sev in MITTEL NIEDRIG; do
    grep "^$sev " "$RAW/sysctl-dev.txt" | cut -d' ' -f2- >"$RAW/sysctl-$sev.txt"
    if [ -s "$RAW/sysctl-$sev.txt" ]; then take "$RAW/sysctl-$sev.txt" 12
      add "$sev" config "$(grep -c . "$RAW/sysctl-$sev.txt") Kernel-Parameter (sysctl) nicht gehärtet" "${ITEMS[@]}"
    fi
  done

  # --- Arbeitsspeicher und Swap ----------------------------------------------
  local swt swf pct swp
  read -r swt swf < <(awk '/^SwapTotal:/{t=$2} /^SwapFree:/{f=$2} END{print t+0, f+0}' /proc/meminfo)
  if (( swt > 0 )); then
    pct=$(( (swt - swf) * 100 / swt ))
    if (( pct > 50 )); then
      add NIEDRIG config "Arbeitsspeicher knapp: Swap zu $pct % belegt" \
        "Belegt: $(( (swt - swf) / 1024 )) MB von $(( swt / 1024 )) MB" \
        "Größte Verbraucher: $(ps -eo comm,rss --sort=-rss | awk 'NR>1 && NR<=6 {printf "%s %d MB; ", $1, $2/1024}')"
    fi
    swp=$(sysctl -n vm.swappiness 2>/dev/null)
    [ -n "$swp" ] && (( swp > 30 )) && add INFO config "Swap wird früh genutzt (vm.swappiness = $swp)" \
      "Empfehlung für Server mit Datenbanken: vm.swappiness = 10"
  fi

  # --- Konten --------------------------------------------------------------
  local u
  u=$(awk -F: '$3==0 && $1!="root"{printf "%s ",$1}' /etc/passwd)
  [ -n "$u" ] && add KRITISCH config "Weitere Konten mit UID 0 (Root-Rechte): $u"
  u=$(awk -F: '$2==""{printf "%s ",$1}' /etc/shadow 2>/dev/null)
  [ -n "$u" ] && add KRITISCH config "Konten ohne Passwort: $u"
  # mit Dateiname (bei Cloud-Servern meist /etc/sudoers.d/90-cloud-init-users für den Standardbenutzer „ubuntu“)
  grep -HsE '^[^#].*NOPASSWD' /etc/sudoers /etc/sudoers.d/* | sed 's/^\([^:]*\):/\1: /' >"$RAW/sudo-nopasswd.txt"
  if [ -s "$RAW/sudo-nopasswd.txt" ]; then take "$RAW/sudo-nopasswd.txt" 5
    add NIEDRIG config "sudo ohne Passwort (NOPASSWD) konfiguriert" "${ITEMS[@]}"
  fi

  # --- Schutzdienste -------------------------------------------------------
  if have aa-status; then aa-status --enabled 2>/dev/null || add MITTEL config "AppArmor ist nicht aktiv"; fi
  if ! systemctl is-active -q fail2ban 2>/dev/null && ! systemctl is-active -q crowdsec 2>/dev/null; then
    add MITTEL config "Kein Brute-Force-Schutz aktiv (fail2ban/CrowdSec)" "Beheben: apt install fail2ban"
  fi
  local fails
  fails=$(journalctl --since "24 hours ago" -q _COMM=sshd 2>/dev/null | grep -cE 'Failed password|Invalid user')
  (( fails > 0 )) && add INFO config "$fails fehlgeschlagene SSH-Anmeldungen in den letzten 24 h"
  return 0
}

# ============================================================================
#  MODUL: perms – Rechte kritischer Dateien, world-writable, SUID, verwaist
# ============================================================================
checkmode() { # checkmode PFAD VERBOTENE_BITS SCHWERE
  local p
  for p in $1; do
    [ -e "$p" ] || continue
    local m o; m=$(stat -c %a "$p"); o=$(stat -c %U "$p")
    if (( 8#$m & 8#$2 )); then add "$3" perms "Unsichere Rechte $m auf $p" "Soll: keine Bits aus $2 gesetzt"; fi
    [ "$o" != root ] && add HOCH perms "$p gehört nicht root, sondern $o"
  done
}

mod_perms() {
  checkmode "/etc/passwd /etc/group" 022 HOCH
  checkmode "/etc/shadow /etc/gshadow" 027 KRITISCH
  checkmode "/etc/sudoers" 027 HOCH
  checkmode "/etc/ssh/sshd_config /etc/crontab /etc/hosts /etc/ld.so.conf /etc/environment" 022 HOCH
  checkmode "$(echo /etc/ssh/ssh_host_*_key)" 037 HOCH
  checkmode "$(echo /etc/cron.d /etc/cron.daily /etc/cron.hourly /etc/cron.weekly /etc/cron.monthly /etc/sudoers.d)" 022 HOCH
  checkmode "/root" 027 NIEDRIG

  # Ein Durchlauf über alle lokalen Dateisysteme
  local m
  : >"$RAW/find.txt"
  for m in $(local_mounts); do
    find "$m" -xdev \( -path /proc -o -path /sys -o -path /dev -o -path /run -o -path /snap \
         -o -path /var/lib/docker -o -path /var/lib/lxcfs \) -prune -o \
      \( -type f -perm /6000 -printf 'SUID %p\n' \) -o \
      \( -type f -perm -0002 -printf 'WWF %p\n' \) -o \
      \( -type d -perm -0002 ! -perm -1000 -printf 'WWD %p\n' \) -o \
      \( \( -nouser -o -nogroup \) -printf 'NOU %p\n' \) 2>/dev/null >>"$RAW/find.txt"
  done
  sed -n 's/^SUID //p' "$RAW/find.txt" | sort -u >"$RAW/suid.txt"
  sed -n 's/^WWF //p'  "$RAW/find.txt" | grep -vE '^/(tmp|var/tmp|dev/shm)/' >"$RAW/ww-files.txt"
  sed -n 's/^WWD //p'  "$RAW/find.txt" >"$RAW/ww-dirs.txt"
  sed -n 's/^NOU //p'  "$RAW/find.txt" >"$RAW/unowned.txt"

  if [ -s "$RAW/ww-files.txt" ]; then take "$RAW/ww-files.txt" 10
    add HOCH perms "$(grep -c . "$RAW/ww-files.txt") Dateien für alle beschreibbar (world-writable)" "${ITEMS[@]}" "Beheben: chmod o-w <datei>"
  fi
  if [ -s "$RAW/ww-dirs.txt" ]; then take "$RAW/ww-dirs.txt" 10
    add HOCH perms "$(grep -c . "$RAW/ww-dirs.txt") Verzeichnisse für alle beschreibbar ohne Sticky-Bit" "${ITEMS[@]}"
  fi
  if [ -s "$RAW/unowned.txt" ]; then take "$RAW/unowned.txt" 8
    add MITTEL perms "$(grep -c . "$RAW/unowned.txt") Dateien ohne gültigen Besitzer/Gruppe" "${ITEMS[@]}"
  fi

  # SUID/SGID-Dateien, die zu keinem Paket gehören
  : >"$RAW/suid-foreign.txt"
  local f alt
  while IFS= read -r f; do
    dpkg -S "$f" >/dev/null 2>&1 && continue
    alt=$(sed -E 's#^/usr/(s?bin|lib|lib32|lib64|libx32)/#/\1/#' <<<"$f")
    [ "$alt" != "$f" ] && dpkg -S "$alt" >/dev/null 2>&1 && continue
    echo "$f" >>"$RAW/suid-foreign.txt"
  done <"$RAW/suid.txt"
  if [ -s "$RAW/suid-foreign.txt" ]; then take "$RAW/suid-foreign.txt" 10
    add HOCH perms "$(grep -c . "$RAW/suid-foreign.txt") SUID/SGID-Programme gehören zu keinem Paket" "${ITEMS[@]}"
  fi
  cp "$RAW/suid.txt" "$STATE_DIR/suid.current"

  # Home-Verzeichnisse & SSH-Schlüssel
  : >"$RAW/home-open.txt"
  for f in /home/*/; do
    [ -d "$f" ] || continue
    m=$(stat -c %a "$f"); (( 8#$m & 8#007 )) && echo "$f ($m)" >>"$RAW/home-open.txt"
  done
  if [ -s "$RAW/home-open.txt" ]; then take "$RAW/home-open.txt" 8
    add NIEDRIG perms "Home-Verzeichnisse für andere Benutzer lesbar" "${ITEMS[@]}"
  fi
  for f in /root/.ssh/authorized_keys* /home/*/.ssh/authorized_keys*; do
    [ -f "$f" ] || continue
    m=$(stat -c %a "$f"); (( 8#$m & 8#022 )) && add HOCH perms "authorized_keys für andere beschreibbar: $f ($m)"
  done
  return 0
}

# ============================================================================
#  MODUL: firewall – aktive Firewall, Default-Policy, offene Ports
# ============================================================================
mod_firewall() {
  local active="" p
  if have ufw && ufw status verbose >"$RAW/ufw.txt" 2>&1 && grep -q '^Status: active' "$RAW/ufw.txt"; then
    active="ufw"
    grep -qE '^Default: (deny|reject) \(incoming\)' "$RAW/ufw.txt" || \
      add HOCH firewall "ufw: Eingehender Verkehr ist standardmäßig erlaubt" "Beheben: ufw default deny incoming"
    if grep -qi '^IPV6=no' /etc/default/ufw 2>/dev/null && ip -6 addr show scope global 2>/dev/null | grep -q inet6; then
      add MITTEL firewall "ufw filtert kein IPv6, obwohl der Server öffentliche IPv6-Adressen hat" "Beheben: IPV6=yes in /etc/default/ufw"
    fi
  fi
  for p in firewalld csf; do systemctl is-active -q "$p" 2>/dev/null && active+=" $p"; done
  if have nft && nft list ruleset >"$RAW/nft.txt" 2>/dev/null; then
    grep -qE 'hook input .*policy drop' "$RAW/nft.txt" && active+=" nftables"
  fi
  if have iptables; then
    iptables -S >"$RAW/iptables.txt" 2>/dev/null
    grep -qE '^-P INPUT (DROP|REJECT)' "$RAW/iptables.txt" && active+=" iptables"
  fi
  if [ -z "$active" ]; then
    add HOCH firewall "Keine aktive Firewall mit Standard-Blockierung erkannt" "Beheben z.B.: ufw allow OpenSSH && ufw enable"
  else
    add INFO firewall "Aktive Firewall: ${active# }"
  fi

  public_ports >"$RAW/ports.txt"
  local proto port prog list="" risk_h="" risk_m=""
  while read -r proto port prog; do
    list+="$port/$proto($prog) "
    [[ " $RISKY_PORTS_HIGH " == *" $port "* ]] && risk_h+="$port/$proto($prog) "
    [[ " $RISKY_PORTS_MED "  == *" $port "* ]] && risk_m+="$port/$proto($prog) "
  done <"$RAW/ports.txt"
  if [ -n "$risk_h" ]; then
    # je Dienst ein konkreter Vorschlag
    local adv=() seen=" " pp
    for pp in $risk_h; do
      port=${pp%%/*}; [[ $seen == *" $port "* ]] && continue; seen+="$port "
      case $port in
        111) adv+=("111 rpcbind – nur für NFS nötig. Ohne NFS: sudo systemctl disable --now rpcbind rpcbind.socket") ;;
        21) adv+=("21 FTP – Passwörter gehen unverschlüsselt übers Netz. Nicht genutzt: sudo systemctl disable --now proftpd; sonst SFTP nutzen oder in Webmin → ProFTPD auf TLS umstellen") ;;
        23) adv+=("23 Telnet – unverschlüsselt, durch SSH ersetzt: sudo apt purge telnetd") ;;
        3306) adv+=("3306 MySQL/MariaDB – in /etc/mysql/mariadb.conf.d/50-server.cnf: bind-address = 127.0.0.1, dann sudo systemctl restart mariadb") ;;
        5432) adv+=("5432 PostgreSQL – in postgresql.conf: listen_addresses = 'localhost'") ;;
        6379) adv+=("6379 Redis – in /etc/redis/redis.conf: bind 127.0.0.1 ::1 und requirepass setzen") ;;
        11211) adv+=("11211 Memcached – in /etc/memcached.conf: -l 127.0.0.1") ;;
        139|445) adv+=("$port Samba – nicht ins Internet: per Firewall sperren (sudo ufw deny $port)") ;;
        2375|2376) adv+=("$port Docker-API – gibt Root-Zugriff! Sofort nur lokal binden oder per Firewall sperren") ;;
        *) adv+=("$port – nur an 127.0.0.1 binden oder per Firewall auf feste IP-Adressen beschränken (sudo ufw deny $port)") ;;
      esac
    done
    add HOCH firewall "Riskante Dienste lauschen öffentlich: $risk_h" "${adv[@]}"
  fi
  [ -n "$risk_m" ] && add MITTEL firewall "Admin-/Web-Oberflächen öffentlich erreichbar: $risk_m" \
    "Empfehlung: per Firewall auf eigene IP-Adressen einschränken"
  [ -n "$list" ] && add INFO firewall "Öffentlich lauschende Ports: $list"
  return 0
}

# ============================================================================
#  MODUL: integrity – veränderte Paketdateien (dpkg), AIDE
# ============================================================================
mod_integrity() {
  dpkg --verify >"$RAW/dpkg-verify.txt" 2>/dev/null
  awk '$1 ~ /^..5/ && $2 != "c" {print $NF}' "$RAW/dpkg-verify.txt" >"$RAW/dpkg-changed.txt"
  local binre='^/(usr/)?(local/)?s?bin/|^/(usr/)?lib(32|64|x32)?/.*\.so(\.[0-9.]+)?$|^/(usr/)?lib/systemd/systemd'
  grep -E  "$binre" "$RAW/dpkg-changed.txt" >"$RAW/dpkg-changed-bin.txt"
  # rkhunter aktualisiert seine eigenen Datendateien (rkhunter --update) – keine Auffälligkeit
  grep -vE "$binre" "$RAW/dpkg-changed.txt" | grep -v '^/var/lib/rkhunter/' >"$RAW/dpkg-changed-other.txt"
  if [ -s "$RAW/dpkg-changed-bin.txt" ]; then take "$RAW/dpkg-changed-bin.txt" 10
    add KRITISCH integrity "$(grep -c . "$RAW/dpkg-changed-bin.txt") Programme/Bibliotheken weichen vom Paket-Original ab" \
      "${ITEMS[@]}" "Prüfen: dpkg -S <datei>; ggf. apt install --reinstall <paket>"
  fi
  if [ -s "$RAW/dpkg-changed-other.txt" ]; then take "$RAW/dpkg-changed-other.txt" 8
    add MITTEL integrity "$(grep -c . "$RAW/dpkg-changed-other.txt") weitere Paketdateien verändert (keine Konfigurationsdateien)" "${ITEMS[@]}"
  fi

  if have aide; then
    local db=/var/lib/aide/aide.db rc
    if aide_aktiv; then
      add INFO integrity "AIDE legt gerade seine Datenbank an – die Prüfung beginnt mit dem nächsten Vollscan danach"
    elif [ -f "$db" ] && [ "$MODE" != full ] && [ "${AIDE_QUICK:-0}" != 1 ]; then
      add INFO integrity "AIDE prüft beim Vollscan (dauert auf großen Servern länger; für den Schnellscan: AIDE_QUICK=1)"
    elif [ -f "$db" ]; then
      aide --config=/etc/aide/aide.conf --check >"$RAW/aide.txt" 2>&1; rc=$?
      if (( rc >= 1 && rc <= 7 )); then
        add MITTEL integrity "AIDE: $(grep -E '^\s*(Added|Removed|Changed) entries' "$RAW/aide.txt" | awk -F: '{gsub(/ entries/,"",$1);gsub(/^[ \t]+/,"",$1);gsub(/[ \t]/,"",$2);printf "%s %s, ",$2,$1}' | sed 's/, $//') seit AIDE-Baseline" \
          "Details: $RAW/aide.txt" "Nach Prüfung übernehmen: ubusec --accept"
      elif (( rc > 7 )); then
        add NIEDRIG integrity "AIDE-Prüfung fehlgeschlagen (Code $rc)" "Log: $RAW/aide.txt"
      fi
    else
      add INFO integrity "AIDE installiert, aber keine Datenbank – in der Weboberfläche unter Werkzeuge „AIDE einrichten“ oder: sudo ubusec --init-baseline"
    fi
  fi
}

# ============================================================================
#  MODUL: baseline – neue Konten, Ports, SSH-Schlüssel, Cronjobs, Dienste, SUID
# ============================================================================
snap_users()    { awk -F: '{print $1" uid="$3" shell="$7}' /etc/passwd | sort; }
snap_sudo()     { cat /etc/sudoers /etc/sudoers.d/* 2>/dev/null | grep -vE '^\s*(#|$)' | sort -u; }
snap_ports()    { public_ports | awk '{print $2"/"$1" ("$3")"}'; }
snap_suid()     { if [ -s "$STATE_DIR/suid.current" ]; then cat "$STATE_DIR/suid.current"; else
                    local m; for m in $(local_mounts); do find "$m" -xdev -type f -perm /6000 2>/dev/null; done | sort -u; fi; }
snap_units()    { systemctl list-unit-files --type=service,timer --state=enabled --no-legend 2>/dev/null | awk '{print $1}' | sort; }
snap_authkeys() { local f; for f in /root/.ssh/authorized_keys* /home/*/.ssh/authorized_keys*; do
                    [ -f "$f" ] && ssh-keygen -lf "$f" 2>/dev/null | awk -v f="$f" '{print f": "$2" "$3}'; done | sort; }
snap_cron()     { local f; for f in /etc/crontab /etc/cron.d/* /var/spool/cron/crontabs/*; do
                    [ -f "$f" ] && grep -vE '^\s*(#|$)' "$f" | sed "s|^|$f: |"; done
                  ls -1 /etc/cron.hourly /etc/cron.daily /etc/cron.weekly /etc/cron.monthly 2>/dev/null; }

BASE_SPECS=(
  "users|KRITISCH|Neue Benutzerkonten"
  "sudo|HOCH|Neue sudo-Regeln"
  "authkeys|HOCH|Neue SSH-Schlüssel (authorized_keys)"
  "ports|HOCH|Neue öffentlich lauschende Ports"
  "cron|MITTEL|Neue Cronjobs"
  "units|MITTEL|Neu aktivierte systemd-Dienste/Timer"
  "suid|HOCH|Neue SUID/SGID-Dateien"
)

write_baseline() {
  local spec name
  for spec in "${BASE_SPECS[@]}"; do name=${spec%%|*}; "snap_$name" >"$BASE_DIR/$name"; done
  date '+%F %T' >"$BASE_DIR/.created"
}

mod_baseline() {
  if [ ! -f "$BASE_DIR/.created" ]; then
    write_baseline
    add INFO baseline "Baseline erstmals angelegt – künftige Scans melden Abweichungen davon"
    return 0
  fi
  local spec name sev label
  for spec in "${BASE_SPECS[@]}"; do
    IFS='|' read -r name sev label <<<"$spec"
    "snap_$name" >"$RAW/base-$name.now"
    comm -13 "$BASE_DIR/$name" "$RAW/base-$name.now" >"$RAW/base-$name.new" 2>/dev/null
    if [ -s "$RAW/base-$name.new" ]; then take "$RAW/base-$name.new" 8
      add "$sev" baseline "$label seit $(cat "$BASE_DIR/.created")" "${ITEMS[@]}" "Wenn beabsichtigt: ubusec --accept"
    fi
  done
}

# ============================================================================
#  MODUL: rootkit – rkhunter, chkrootkit, unhide, eigene Einbruchs-Heuristiken
# ============================================================================
# chkrootkit meldet „Potential bindshell“ allein anhand der Portnummer. Mehrere dieser Ports
# gehören zu ganz normalen Diensten (465 = SMTPS des Mailservers, 4369 = Erlang …). Deshalb:
# nachsehen, welches Programm wirklich auf dem Port lauscht, und nur Unbekanntes als kritisch melden.
BINDSHELL_OK_RX='^(master|postfix|smtpd|exim|exim4|sendmail|dovecot|apache2|httpd|nginx|haproxy|epmd|beam\.smp|sshd|named|icinga2)$'
port_name() { case $1 in 465) echo "SMTPS – verschlüsselter Mailversand" ;; 4369) echo "Erlang-Portmapper (RabbitMQ, CouchDB)" ;;
  5665) echo "Icinga" ;; 6667) echo "IRC" ;; *) echo "" ;; esac; }
chk_bindshell() { # chk_bindshell ZEILE
  local line=$1 p procs ok=() bad=() gone=() name ports
  have ss || { add KRITISCH rootkit "chkrootkit: $line"; return; }
  ports=$(grep -oE '[0-9]+' <<<"${line##*ports:}" | paste -sd'|' -)
  for p in ${ports//|/ }; do
    procs=$(ss -Htlnp "sport = :$p" 2>/dev/null | grep -oE 'users:\(\("[^"]+' | sed 's/.*"//' | sort -u | paste -sd, -)
    name=$(port_name "$p")
    local shown=${procs/master/master (Postfix)}
    if [ -z "$procs" ]; then gone+=("Port $p${name:+ ($name)}: derzeit lauscht dort kein Programm")
    elif ! tr ',' '\n' <<<"$procs" | grep -qvE "$BINDSHELL_OK_RX"; then ok+=("Port $p${name:+ ($name)}: gehört zu $shown")
    else bad+=("Port $p${name:+ ($name)}: gehört zu $shown"); fi
  done
  if (( ${#bad[@]} > 0 )); then
    add KRITISCH rootkit "chkrootkit: $line" "${bad[@]}" "${gone[@]}" "${ok[@]}" \
      "Prüfen: sudo ss -tlnp | grep -E ':($ports)\\b' – welches Programm ist das, wo liegt es (ls -l /proc/PID/exe)?"
  elif (( ${#gone[@]} > 0 )); then
    add MITTEL rootkit "chkrootkit: Bindshell-Warnung – Port nicht zuzuordnen" "${gone[@]}" "${ok[@]}" \
      "Der Dienst lief wohl nur kurz. Beim nächsten Scan erneut prüfen; taucht die Warnung wieder auf: sudo ss -tlnp | grep -E ':($ports)\\b'"
  else
    add INFO rootkit "chkrootkit: Bindshell-Warnung ist ein Fehlalarm" "${ok[@]}" \
      "chkrootkit erkennt Hintertüren nur an der Portnummer; auf diesem Port lauscht ein bekannter Dienst"
  fi
}

# Collabora Online aus der Nextcloud-App „Built-in CODE Server“ (richdocumentscode) entpackt sich als
# AppImage nach /tmp/appimage_extracted_<MD5>. Als harmlos gilt ein solcher Ordner nur, wenn
#   – die Prozesse Collabora-Programme daraus sind und nicht als root laufen,
#   – das zugehörige AppImage im richdocumentscode-Ordner einer Nextcloud liegt und
#   – die MD5-Prüfsumme dieser Datei genau dem Ordnernamen entspricht (so benennt ihn die AppImage-Laufzeit).
declare -A CODE_OK=() CODE_MD5=() CODE_USER=()
code_md5() { [ -n "${CODE_MD5[$1]:-}" ] || CODE_MD5[$1]=$(md5sum <"$1" 2>/dev/null | cut -d' ' -f1); echo "${CODE_MD5[$1]}"; }
code_verify() { # code_verify LISTE – entfernt geprüfte Collabora-Prozesse aus der Liste, füllt CODE_OK
  local list=$1 line pid exe dir sum ai u cand=() rx='^(/tmp/appimage_extracted_([0-9a-f]{32}))/usr/bin/(coolwsd|coolforkit[a-z-]*|coolmount|loolwsd|loolforkit[a-z-]*)$'
  declare -A want=()
  [ -s "$list" ] || return 0
  while IFS= read -r line; do
    pid=${line#PID }; pid=${pid%%:*}
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || continue
    [[ $exe =~ $rx ]] || continue
    dir=${BASH_REMATCH[1]}; sum=${BASH_REMATCH[2]}
    u=$(stat -c %U "/proc/$pid" 2>/dev/null); [ -n "$u" ] && [ "$u" != root ] || { want[$dir]=bad; continue; }
    [ "${want[$dir]:-}" = bad ] || { want[$dir]=$sum; CODE_USER[$dir]=$u; }
    # das AppImage nennt sich selbst in der Umgebung des Prozesses
    ai=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^APPIMAGE=//p' | head -1)
    [[ $ai == */richdocumentscode*/collabora/*.AppImage ]] && [ -f "$ai" ] && cand+=("$ai")
  done <"$list"
  (( ${#want[@]} > 0 )) || return 0
  # sonst im richdocumentscode-Ordner der Nextcloud-Installationen suchen
  if (( ${#cand[@]} == 0 )); then
    local roots=() r; for r in $WEB_PATHS /var/www; do [ -d "$r" ] && roots+=("$r"); done
    (( ${#roots[@]} > 0 )) && while IFS= read -r ai; do cand+=("$ai"); done < <(
      timeout 120 find "${roots[@]}" -maxdepth 8 \( -name data -o -name files -o -name Maildir -o -name logs \) -prune \
        -o -type f -name '*.AppImage' -path '*/richdocumentscode*/collabora/*' -print 2>/dev/null | sort -u)
  fi
  for dir in "${!want[@]}"; do
    [ "${want[$dir]}" = bad ] && continue
    for ai in "${cand[@]}"; do
      [ "$(code_md5 "$ai")" = "${want[$dir]}" ] && { CODE_OK[$dir]=$ai; break; }
    done
  done
  for dir in "${!CODE_OK[@]}"; do grep -vF -- ": $dir/usr/bin/" "$list" >"$list.n"; mv -f "$list.n" "$list"; done
  return 0
}

# rkhunter meldet jede unbekannte Datei unter /dev/shm. Viele Dienste legen dort gemeinsamen Speicher an
# (Apache/APR: ShM.<hash>, PostgreSQL, PHP-FPM, Collabora …). Harmlos ist eine solche Datei nur, wenn sie
# keine Programmdatei ist und ausschließlich von bekannten Diensten in den Speicher eingeblendet wird.
SHM_OK_RX='^(apache2|httpd|nginx|postgres|php-fpm[0-9.]*|mysqld|mariadbd|coolwsd|kit_[a-z0-9_]+|forkit|coolforkit[a-z-]*|dovecot|redis-server|memcached)$'
chk_devshm() { # chk_devshm WARNUNG → 0, wenn alle genannten Dateien erklärt sind (dann als INFO gemeldet)
  local w=$1 f users ok=() bad=() stale=0
  local files; files=$(grep -oE '/dev/shm/[^ :]+' <<<"$w" | sort -u)
  [ -n "$files" ] || return 1
  grep -vqE '^/dev/shm/' <<<"$(grep -oE '/dev/[^ :]+' <<<"$w" | sort -u)" && return 1   # auch Dateien außerhalb von /dev/shm
  while IFS= read -r f; do
    [ -e "$f" ] || { ok+=("$f: inzwischen verschwunden"); continue; }
    if [ "$(head -c4 "$f" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 7f454c46 ] || [ -x "$f" ]; then
      bad+=("$f: Programmdatei oder ausführbar"); continue
    fi
    users=$(grep -lsF -- "$f" /proc/[0-9]*/maps 2>/dev/null | cut -d/ -f3 | while read -r p; do cat "/proc/$p/comm" 2>/dev/null; done | sort -u | paste -sd, -)
    if [ -z "$users" ]; then ok+=("$f: von keinem Prozess genutzt ($(stat -c %U "$f"), $(stat -c %y "$f" | cut -d. -f1)) – meist Überbleibsel eines beendeten Dienstes"); stale=1
    elif tr ',' '\n' <<<"$users" | grep -qvE "$SHM_OK_RX"; then bad+=("$f: genutzt von $users")
    else ok+=("$f: gemeinsamer Speicher von $users"); fi
  done <<<"$files"
  (( ${#bad[@]} == 0 )) || { add HOCH rootkit "rkhunter: $w" "${bad[@]}" "${ok[@]}"; return 0; }
  if (( stale )); then
    add NIEDRIG rootkit "rkhunter: Datei(en) in /dev/shm ohne zugehörigen Prozess" "${ok[@]}" \
      "Keine Programmdatei; verschwindet beim Neustart. Unbekannt? Inhalt ansehen: sudo strings DATEI | head"
    return 0
  fi
  add INFO rootkit "rkhunter: Dateien in /dev/shm sind gemeinsamer Speicher bekannter Dienste (Fehlalarm)" "${ok[@]}" \
    "Meldung bei rkhunter abstellen: in /etc/rkhunter.conf.local z. B. ALLOWDEVFILE=/dev/shm/ShM.* eintragen"
  return 0
}

# chkrootkit sucht in Systemprogrammen nach Zeichenketten bekannter Rootkits. Neuere Programmversionen
# (z. B. die Rust-Coreutils von Ubuntu 25.10/26.04, ein einziges großes Programm für ls, basename, date …)
# enthalten solche Zeichenketten zufällig – dann meldet chkrootkit „INFECTED“. Entscheidend ist, ob die Datei
# byte-gleich mit der aus dem offiziellen Paket ist. Dafür lädt ubusec das Paket in der installierten Version
# frisch von Ubuntu (nicht nur die lokale Prüfsummenliste, die ein Angreifer mit root-Rechten ändern könnte).
declare -A INF_OK=() INF_BAD=() INF_LOCAL=() DEB_DIR=(); DEB_OUT=""
deb_extract() { # deb_extract PAKET → DEB_OUT = Ordner mit dem entpackten Originalpaket (leer bei Fehler)
  local pkg=$1 ver d
  [ -n "${DEB_DIR[$pkg]+x}" ] && { DEB_OUT=${DEB_DIR[$pkg]}; return; }
  ver=$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null)
  d=$(mktemp -d "$STATE_DIR/work/deb.XXXXXX"); chmod 755 "$d"
  if [ -n "$ver" ] && (cd "$d" && timeout 120 apt-get download -q "$pkg=$ver" >/dev/null 2>&1) \
     && dpkg-deb -x "$d"/*.deb "$d/x" 2>/dev/null; then DEB_DIR[$pkg]=$d/x
  else rm -rf "$d"; DEB_DIR[$pkg]=""; fi
  DEB_OUT=${DEB_DIR[$pkg]}
}
chk_infected_binary() { # chk_infected_binary ZEILE → 0, wenn behandelt (Ergebnis wird gesammelt)
  local line=$1 name bin real pkg dir f orig
  name=$(sed -n "s/.*Checking \`\\([^']*\\)'.*/\\1/p" <<<"$line")
  [[ $name =~ ^[a-z0-9._+-]+$ ]] || return 1
  for f in "/usr/bin/$name" "/bin/$name" "/usr/sbin/$name" "/sbin/$name"; do [ -e "$f" ] && { bin=$f; break; }; done
  [ -n "$bin" ] || return 1
  real=$(readlink -f "$bin")
  pkg=$(dpkg -S "$real" 2>/dev/null | head -1 | cut -d: -f1)
  [ -n "$pkg" ] || pkg=$(dpkg -S "$bin" 2>/dev/null | head -1 | cut -d: -f1)
  [ -n "$pkg" ] || return 1
  deb_extract "$pkg"; dir=$DEB_OUT
  orig=""
  if [ -n "$dir" ]; then for f in "$dir$real" "$dir$bin" "$dir/usr${bin#/usr}" "$dir${real#/usr}"; do [ -f "$f" ] && { orig=$f; break; }; done; fi
  if [ -n "$orig" ]; then
    if cmp -s "$real" "$orig"; then INF_OK[$pkg]+="$name "; else INF_BAD[$pkg]+="$name($real) "; fi
  elif ! dpkg --verify "$pkg" 2>/dev/null | grep -q " $real\$"; then INF_LOCAL[$pkg]+="$name "
  else INF_BAD[$pkg]+="$name($real) "; fi
  return 0
}
report_infected_binaries() {
  local p
  for p in "${!INF_BAD[@]}"; do
    add KRITISCH rootkit "chkrootkit: Programme melden „INFECTED“ und weichen vom Original-Paket ab" \
      "Paket $p: ${INF_BAD[$p]}" "Notfall-Hinweise befolgen; Vergleich: sudo dpkg --verify $p"
  done
  for p in "${!INF_LOCAL[@]}"; do
    add MITTEL rootkit "chkrootkit meldet „INFECTED“ – vermutlich Fehlalarm, Originalpaket nicht ladbar" \
      "Paket $p: ${INF_LOCAL[$p]}" "Laut lokaler Paketprüfsumme unverändert; der Abgleich mit dem Originalpaket von Ubuntu war nicht möglich (keine Verbindung?)"
  done
  for p in "${!INF_OK[@]}"; do
    add INFO rootkit "chkrootkit: „INFECTED“-Meldungen sind Fehlalarme – Programme identisch mit dem Originalpaket" \
      "Paket $p ($(dpkg-query -W -f='${Version}' "$p" 2>/dev/null)): ${INF_OK[$p]}" \
      "Byte-genau verglichen mit dem frisch von Ubuntu geladenen Paket. chkrootkit erkennt Rootkits an Zeichenketten, die in neueren Programmversionen zufällig vorkommen."
  done
  local d; for d in "${DEB_DIR[@]}"; do [ -n "$d" ] && rm -rf "${d%/x}"; done
  return 0
}

mod_rootkit() {
  # --- rkhunter --------------------------------------------------------------
  if need rkhunter rootkit rkhunter; then
    if [ ! -s /var/lib/rkhunter/db/rkhunter.dat ]; then
      rkhunter --propupd --nocolors >"$RAW/rkhunter-propupd.log" 2>&1
      add INFO rootkit "rkhunter-Datenbank neu angelegt (Dateieigenschaften als Referenz)"
    fi
    [ "$MODE" = full ] && rkhunter --update --nocolors >"$RAW/rkhunter-update.log" 2>&1
    rkhunter --check --sk --nocolors --noappend-log --logfile "$RAW/rkhunter.log" >"$RAW/rkhunter.out" 2>&1
    awk '
      /Warning: / { if (w) print w; sub(/^\[[0-9:]+\] Warning: /,""); w=$0; next }
      w && /^\[[0-9:]+\]  +[^ ]/ && !/\[ [A-Za-z ]+ \][[:space:]]*$/ { l=$0; sub(/^\[[0-9:]+\] +/,"",l); if (length(w)<220) w=w" "l; next }
      { if (w) print w; w="" }
      END { if (w) print w }' "$RAW/rkhunter.log" 2>/dev/null >"$RAW/rkhunter-warnings.txt"
    local w sev
    local hidden=() hidden_ok=() etck=0 hp
    dpkg -s etckeeper >/dev/null 2>&1 && etck=1
    while IFS= read -r w; do
      if [[ $w == "Suspicious file types found in /dev"* ]] && chk_devshm "$w"; then continue; fi
      if [[ $w =~ ^Hidden\ (file|directory)\ found:\ ([^:]+) ]]; then
        hp=${BASH_REMATCH[2]}
        # etckeeper verwaltet /etc mit git; /etc/.updated legt systemd nach Updates an
        if { (( etck )) && [[ $hp =~ ^/etc/\.(git|etckeeper|gitignore)$ ]]; } || [ "$hp" = /etc/.updated ]; then hidden_ok+=("$hp")
        else hidden+=("$w"); fi
        continue
      fi
      if [[ $w == "The SSH and rkhunter configuration options should be the same"* ]]; then
        add INFO rootkit "rkhunter: SSH-Einstellung PermitRootLogin weicht von rkhunter ab – siehe SSH-Befunde unter „Konfiguration“" \
          "Verschwindet, sobald PermitRootLogin geändert ist (oder ALLOW_SSH_ROOT_USER in /etc/rkhunter.conf.local anpassen)"
        continue
      fi
      sev=MITTEL
      [[ $w =~ propert(y|ies)\ ha(s|ve)\ changed|replaced\ by\ a\ script|[Dd]eleted\ file|[Pp]romiscuous|[Ss]uspicious\ string ]] && sev=HOCH
      [[ $w =~ [Rr]ootkit|[Bb]ackdoor|[Tt]rojan ]] && sev=KRITISCH
      add "$sev" rootkit "rkhunter: $w"
    done <"$RAW/rkhunter-warnings.txt"
    (( ${#hidden[@]} > 0 )) && add MITTEL rootkit "rkhunter: ${#hidden[@]} versteckte Dateien/Ordner in Systemverzeichnissen" "${hidden[@]}" \
      "Erklärbar (z. B. Backup einer Konfigurationsdatei)? Freigeben in /etc/rkhunter.conf.local: ALLOWHIDDENFILE=/pfad bzw. ALLOWHIDDENDIR=/pfad"
    (( ${#hidden_ok[@]} > 0 )) && add INFO rootkit "rkhunter: versteckte Dateien von etckeeper/systemd erkannt (harmlos)" "${hidden_ok[@]}"
  fi

  # --- chkrootkit ------------------------------------------------------------
  if need chkrootkit rootkit chkrootkit; then
    chkrootkit -q >"$RAW/chkrootkit.txt" 2>&1
    grep -i 'INFECTED' "$RAW/chkrootkit.txt" >"$RAW/chkrootkit-inf.txt"
    while IFS= read -r w; do
      if [[ $w == *bindshell* ]]; then chk_bindshell "$w"
      elif ! chk_infected_binary "$w"; then add KRITISCH rootkit "chkrootkit: $w"; fi
    done <"$RAW/chkrootkit-inf.txt"
    report_infected_binaries
    # Übrige Meldungen abschnittsweise bewerten (Paketdateien, Collabora in /tmp, Netzwerkdienste …)
    local vpy=$CHECK_DIR/verify.py; [ -f "$vpy" ] || vpy=$SRC_DIR/checks/verify.py
    grep -v 'INFECTED' "$RAW/chkrootkit.txt" >"$RAW/chkrootkit-rest.txt"
    if [ -f "$vpy" ] && timeout 20m python3 -I "$vpy" chkrootkit-classify "$RAW/chkrootkit-rest.txt" "$RAW/chkrootkit-class.tsv" 2>>"$RAW/chkrootkit-class.err"; then
      # sev/msg ausdrücklich leeren: „local sev“ ein zweites Mal in derselben Funktion behält den Wert aus dem
      # rkhunter-Teil oben – dann würde ein Befund mit falscher Schwere ohne Text gemeldet (bzw. bricht ab)
      local kind sev="" msg="" det=() line a b
      flush_chk() { [ -n "${sev:-}" ] && add "$sev" rootkit "${msg:-chkrootkit}" "${det[@]}"; sev=""; msg=""; det=(); }
      while IFS=$'\t' read -r kind a b; do
        case $kind in
          F) flush_chk; sev=$a; msg=$b ;;
          D) det+=("$a") ;;
        esac
      done <"$RAW/chkrootkit-class.tsv"
      flush_chk
    elif grep -qvE '^\s*$|^RTNETLINK' "$RAW/chkrootkit-rest.txt"; then
      grep -vE '^\s*$|^RTNETLINK' "$RAW/chkrootkit-rest.txt" >"$RAW/chkrootkit-other.txt"; take "$RAW/chkrootkit-other.txt" 5
      add MITTEL rootkit "chkrootkit meldet Auffälligkeiten (oft harmlos, bitte prüfen)" "${ITEMS[@]}"
    fi
  fi

  # --- unhide (nur Vollscan) ---------------------------------------------------
  if [ "$MODE" = full ] && have unhide-linux; then
    unhide-linux quick >"$RAW/unhide.txt" 2>&1
    grep -i 'Found HIDDEN PID' "$RAW/unhide.txt" >"$RAW/unhide-hits.txt"
    if [ -s "$RAW/unhide-hits.txt" ]; then take "$RAW/unhide-hits.txt" 5
      add HOCH rootkit "unhide: Versteckte Prozesse gefunden (kurzlebige Prozesse können Fehlalarme auslösen)" "${ITEMS[@]}"
    fi
    if have unhide-tcp; then
      unhide-tcp >"$RAW/unhide-tcp.txt" 2>&1
      grep -qi 'Found Hidden port' "$RAW/unhide-tcp.txt" && add HOCH rootkit "unhide-tcp: Versteckte Ports gefunden" "Log: $RAW/unhide-tcp.txt"
    fi
  elif [ "$MODE" = full ]; then need unhide-linux rootkit unhide; fi

  heuristics
}

heuristics() {
  # LD_PRELOAD-Rootkits
  if [ -s /etc/ld.so.preload ]; then
    add KRITISCH rootkit "/etc/ld.so.preload ist gesetzt (typisch für Userland-Rootkits)" "Inhalt: $(tr '\n' ' ' </etc/ld.so.preload)"
  fi

  # Prozesse aus temporären Verzeichnissen oder mit gelöschter Programmdatei
  local p exe cmd
  : >"$RAW/proc-tmp.txt"; : >"$RAW/proc-deleted.txt"
  for p in /proc/[0-9]*; do
    exe=$(readlink "$p/exe" 2>/dev/null) || continue
    cmd=$(tr '\0' ' ' <"$p/cmdline" 2>/dev/null | cut -c1-80)
    case $exe in
      /tmp/*|/var/tmp/*|/dev/shm/*|/run/shm/*) echo "PID ${p#/proc/}: $exe  [$cmd]" >>"$RAW/proc-tmp.txt" ;;
      *" (deleted)")
        case $exe in /usr/*|/lib/*|/opt/*|/snap/*|/memfd:*) ;;
          *) echo "PID ${p#/proc/}: $exe  [$cmd]" >>"$RAW/proc-deleted.txt" ;; esac ;;
    esac
  done
  code_verify "$RAW/proc-tmp.txt"
  if [ -s "$RAW/proc-tmp.txt" ]; then take "$RAW/proc-tmp.txt" 8
    add KRITISCH rootkit "Prozesse laufen aus temporären Verzeichnissen" "${ITEMS[@]}"
  fi
  if (( ${#CODE_OK[@]} > 0 )); then
    local d info=()
    for d in "${!CODE_OK[@]}"; do info+=("$d → entpackt aus ${CODE_OK[$d]} (MD5-Prüfsumme stimmt, läuft als ${CODE_USER[$d]})"); done
    add INFO rootkit "Collabora Online (Nextcloud Office) läuft aus /tmp – erkannt und geprüft" "${info[@]}" \
      "Die Nextcloud-App „Built-in CODE Server“ entpackt sich dorthin; der Ordnername ist die Prüfsumme der Original-Datei"
  fi
  if [ -s "$RAW/proc-deleted.txt" ]; then take "$RAW/proc-deleted.txt" 8
    add HOCH rootkit "Prozesse laufen aus gelöschten Dateien außerhalb der Systempfade" "${ITEMS[@]}"
  fi

  # Bekannte Cryptominer / Malware-Familien
  ps -eo pid=,user=,args= 2>/dev/null | awk -v me=$$ '$1!=me' \
    | grep -iE 'xmrig|kdevtmpfsi|kinsing|minerd|cpuminer|xmr-stak|cryptonight|stratum\+(tcp|ssl)|nbminer|lolminer|\-\-donate-level|tsunami|kaiten|mirai|perfctl|perfcc|sysrv' \
    | grep -v grep >"$RAW/proc-malware.txt"
  if [ -s "$RAW/proc-malware.txt" ]; then take "$RAW/proc-malware.txt" 5
    add KRITISCH rootkit "Prozesse mit Namen bekannter Cryptominer/Malware" "${ITEMS[@]}"
  fi

  # Verbindungen zu typischen Mining-Pool-Ports
  ss -H -tnp state established 2>/dev/null | awk '
    { n=split($4,a,":"); port=a[n]
      if (port ~ /^(3333|4444|5555|6666|7777|9999|14433|14444|45560|45700)$/) print $4"  "$5 }' >"$RAW/net-miner.txt"
  if [ -s "$RAW/net-miner.txt" ]; then take "$RAW/net-miner.txt" 5
    add HOCH rootkit "Ausgehende Verbindungen zu typischen Mining-/C2-Ports" "${ITEMS[@]}"
  fi

  # Netzwerkkarten im Promiscuous-Mode (Sniffer)
  local pr; pr=$(ip -o link show 2>/dev/null | awk -F': ' '/PROMISC/{printf "%s ",$2}')
  [ -n "$pr" ] && add MITTEL rootkit "Netzwerkschnittstellen im Promiscuous-Mode (Sniffer?): $pr"

  # Ausführbare Dateien & versteckte Verzeichnisse in tmp
  : >"$RAW/tmp-elf.txt"; : >"$RAW/tmp-exec.txt"
  local f
  while IFS= read -r -d '' f; do
    if [ "$(head -c4 "$f" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 7f454c46 ]; then echo "$f" >>"$RAW/tmp-elf.txt"
    elif [ -x "$f" ]; then echo "$f" >>"$RAW/tmp-exec.txt"; fi
  done < <(find /tmp /var/tmp /dev/shm -xdev -type f \( -perm /111 -o -size +10k \) -print0 2>/dev/null)
  if (( ${#CODE_OK[@]} > 0 )) && [ -s "$RAW/tmp-elf.txt" ]; then   # Dateien des geprüften Collabora-Ordners
    local d; for d in "${!CODE_OK[@]}"; do grep -vF -- "$d/" "$RAW/tmp-elf.txt" >"$RAW/tmp-elf.txt.n"; mv -f "$RAW/tmp-elf.txt.n" "$RAW/tmp-elf.txt"
      grep -vF -- "$d/" "$RAW/tmp-exec.txt" >"$RAW/tmp-exec.txt.n"; mv -f "$RAW/tmp-exec.txt.n" "$RAW/tmp-exec.txt"; done
  fi
  # Collabora Online legt unter /tmp/coolwsd.*/systemplate eine Kopie von Systembibliotheken für seine
  # abgeschotteten Dokumentprozesse an. Harmlos, wenn jede Datei byte-gleich mit dem Original im System ist.
  local sysok=0 l orig
  for l in tmp-elf tmp-exec; do
    : >"$RAW/$l.n"
    while IFS= read -r f; do
      if [[ $f == /tmp/coolwsd.*/systemplate/* ]]; then
        orig=/${f#*/systemplate/}
        if [ -f "$orig" ] && cmp -s -- "$f" "$orig"; then sysok=$((sysok+1)); continue; fi
      fi
      echo "$f" >>"$RAW/$l.n"
    done <"$RAW/$l.txt"
    mv -f "$RAW/$l.n" "$RAW/$l.txt"
  done
  (( sysok > 0 )) && add INFO rootkit "Collabora-Systemvorlage in /tmp/coolwsd.*: $sysok Programmdateien geprüft – identisch mit den Systemdateien"
  if [ -s "$RAW/tmp-elf.txt" ]; then take "$RAW/tmp-elf.txt" 8
    add HOCH rootkit "Programmdateien (ELF) in temporären Verzeichnissen" "${ITEMS[@]}"
  fi
  if [ -s "$RAW/tmp-exec.txt" ]; then take "$RAW/tmp-exec.txt" 8
    add NIEDRIG rootkit "Ausführbare Skripte in temporären Verzeichnissen" "${ITEMS[@]}"
  fi
  find /tmp /var/tmp /dev/shm -xdev -mindepth 1 -maxdepth 3 -name '.*' \
    ! -name '.X11-unix' ! -name '.ICE-unix' ! -name '.font-unix' ! -name '.XIM-unix' ! -name '.Test-unix' \
    ! -name '.lock' ! -name '.org.chromium.*' ! -name '.s.PGSQL.*' ! -name '.X*-lock' 2>/dev/null >"$RAW/tmp-hidden.txt"
  # bekannte Fälle: Webmin-Arbeitsordner (root), Symbol im geprüften Collabora-AppImage
  { [ -d /tmp/.webmin ] && [ "$(stat -c %U /tmp/.webmin)" = root ] && [ -d /etc/webmin ] && echo /tmp/.webmin
    for d in "${!CODE_OK[@]}"; do echo "$d/.DirIcon"; done; } >"$RAW/tmp-hidden-ok.txt"
  grep -vxF -f "$RAW/tmp-hidden-ok.txt" "$RAW/tmp-hidden.txt" >"$RAW/tmp-hidden.n" || true
  mv -f "$RAW/tmp-hidden.n" "$RAW/tmp-hidden.txt"
  if [ -s "$RAW/tmp-hidden.txt" ]; then take "$RAW/tmp-hidden.txt" 8
    add MITTEL rootkit "Versteckte Dateien/Verzeichnisse in temporären Verzeichnissen" "${ITEMS[@]}"
  fi

  # Verdächtige Befehle in Autostart-Orten (Cron, systemd, rc.local, Shell-Profile)
  grep -HnsIE 'curl[^|#]*\|[[:space:]]*(ba|z|da)?sh|wget[^|#]*\|[[:space:]]*(ba|z|da)?sh|base64[[:space:]]+(-d|--decode)|/dev/tcp/|\bnc(at)?\b[^|]*-e[[:space:]]|python[23]?[[:space:]]+-c|/dev/shm/|/tmp/\.|chattr[[:space:]]+\+i|LD_PRELOAD=' \
    /etc/crontab /etc/cron.d/* /etc/cron.hourly/* /etc/cron.daily/* /etc/cron.weekly/* /etc/cron.monthly/* \
    /var/spool/cron/crontabs/* /etc/rc.local /etc/profile /etc/profile.d/* /etc/bash.bashrc \
    /root/.bashrc /root/.profile /etc/systemd/system/*.service /etc/systemd/system/*/*.service /etc/update-motd.d/* 2>/dev/null \
    | awk '{ c = $0; sub(/^[^:]*:[0-9]+:/, "", c); if (c !~ /^[[:space:]]*(#|;)/) print }' | cut -c1-200 >"$RAW/autostart-susp.txt"   # Kommentarzeilen zählen nicht
  if [ -s "$RAW/autostart-susp.txt" ]; then take "$RAW/autostart-susp.txt" 8
    add HOCH rootkit "Verdächtige Befehle in Autostart-Dateien (Cron/systemd/Profile)" "${ITEMS[@]}"
  fi
}

