apply_schedule() {
  local t U on days tm
  for t in quick full; do
    U=${t^^}; on=${U}_ON; days=${U}_DAYS; tm=${U}_TIME
    install -d -m 0755 "/etc/systemd/system/ubusec-$t.timer.d"
    printf '# von ubusec erzeugt\n[Timer]\nOnCalendar=\nOnCalendar=%s *-*-* %s:00\n' "${!days}" "${!tm}" \
      >"/etc/systemd/system/ubusec-$t.timer.d/zeitplan.conf"
  done
  systemctl daemon-reload 2>/dev/null
  for t in quick full; do
    U=${t^^}; on=${U}_ON
    if [ "${!on}" = 1 ]; then systemctl enable --now "ubusec-$t.timer" >/dev/null 2>&1
    else systemctl disable --now "ubusec-$t.timer" >/dev/null 2>&1; fi
  done
}

